<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/qb_px_12"/>
            <solid android:color="@color/colorPrimaryDark"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/qb_px_12"/>
                <gradient
                    android:startColor="@color/color_40c1d5"
                    android:endColor="@color/color_aef3fe"
                    android:angle="0"
                    android:type="linear"
                    android:centerX="50%"
                    android:centerY="50%"/>
            </shape>
        </clip>
    </item>
</layer-list>
