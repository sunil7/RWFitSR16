<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/str_about"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/appLogo"
        android:layout_width="@dimen/qb_px_100"
        android:layout_height="@dimen/qb_px_100"
        android:layout_marginTop="@dimen/dp_40"
        android:src="@mipmap/ic_launcher"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:text="@string/app_name"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:text="v 1.0.0"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/av_help"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_40"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_help"
        app:item_resource="@mipmap/ic_help"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/avUserPro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_user_protocol"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/avPrivacyPol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_privacy_policy"/>
</LinearLayout>
