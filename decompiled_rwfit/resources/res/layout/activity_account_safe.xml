<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/str_account_safe"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10">
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_account_current"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="?attr/colorOnPrimary"
            android:id="@+id/accountTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginStart="@dimen/qb_px_6"/>
    </LinearLayout>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/accountBindAv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_account_bind"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/accountCancelAv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_account_cancel"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/updatePwAv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_update_pw"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_0"
        android:layout_weight="1"/>
    <Button
        android:textSize="@dimen/qb_px_14"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/loginOutBtn"
        android:background="@drawable/bg_item_theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qb_px_44"
        android:text="@string/str_login_out"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"/>
</LinearLayout>
