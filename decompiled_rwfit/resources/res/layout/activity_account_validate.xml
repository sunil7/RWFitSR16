<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleViewMiddle
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/str_register"/>
    <com.example.test.ui.view.InputView
        android:id="@+id/accountIv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_38"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:input_hint="@string/str_account"
        app:input_icon="@mipmap/ic_account"/>
    <com.example.test.ui.view.InputView
        android:id="@+id/verifyCodeIv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:input_action_txt="@string/str_rev_code"
        app:input_hint="@string/str_verification_code"
        app:input_icon="@mipmap/ic_verify_code"/>
    <com.example.test.ui.view.InputView
        android:id="@+id/pwIv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:input_action_img_show="@mipmap/ic_disvisiable"
        app:input_hint="@string/str_password"
        app:input_icon="@mipmap/ic_pw"
        app:input_is_pw="true"/>
    <com.example.test.ui.view.InputView
        android:id="@+id/pwAgainIv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:input_action_img_show="@mipmap/ic_disvisiable"
        app:input_hint="@string/str_password_again"
        app:input_icon="@mipmap/ic_pw"
        app:input_is_pw="true"/>
    <com.example.test.ui.view.InputView
        android:id="@+id/pwNewAgainIv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:input_action_img_show="@mipmap/ic_disvisiable"
        app:input_hint="@string/str_please_input_npw_again"
        app:input_icon="@mipmap/ic_pw"
        app:input_is_pw="true"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/tvReadProtocol"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        android:text="请查阅《用户协议》、《隐私协议》"
        android:paddingStart="@dimen/qb_px_16"
        android:paddingEnd="@dimen/qb_px_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProContent"/>
    <Button
        android:enabled="false"
        android:textColor="@android:color/white"
        android:id="@+id/btnRegister"
        android:background="@drawable/selector_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_28"
        android:text="@string/str_register"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="?attr/colorOnPrimary"
        android:gravity="right"
        android:id="@+id/tvHasAccount"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        android:text="@string/str_has_account"
        android:layout_marginEnd="@dimen/qb_px_10"/>
</LinearLayout>
