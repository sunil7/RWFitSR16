<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.testui.TRingToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_option1="@drawable/svg_reminder"
        app:bar_status_res="@drawable/svg_ic_tb_back"
        app:bar_title="@string/str_bo_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.example.test.ui.testui.TRingDateSelectView
        android:id="@+id/view_date_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_20"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_date_select">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:background="@drawable/shape_background_theme"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="@string/ring_bo_watcher"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/qb_px_15"
                    android:layout_toStartOf="@+id/scBtn"
                    android:layout_alignParentStart="true"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/scBtn"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20"
                    android:layout_alignParentEnd="true"
                    app:thumbTint="@color/ring_bottomtext_sel"
                    app:trackTint="@drawable/ring_switch_track_color"/>
                <TextView
                    android:textSize="@dimen/qb_px_13"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_bo_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:text="@string/ring_bo_watcher_tips"
                    android:layout_below="@+id/tv_title"
                    android:layout_marginStart="@dimen/qb_px_20"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/shape_background_theme"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_300"
                android:layout_marginTop="@dimen/qb_px_20"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_data_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="@string/ring_bo_detail_title"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_toStartOf="@+id/ll_desc"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/qb_px_30"
                    android:layout_marginTop="@dimen/qb_px_25"
                    android:layout_marginEnd="@dimen/qb_px_20"
                    android:layout_alignParentEnd="true">
                    <TextView
                        android:textSize="@dimen/qb_px_12"
                        android:textColor="@color/ring_desctext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ring_hr_readme"/>
                    <ImageView
                        android:layout_width="@dimen/qb_px_10"
                        android:layout_height="@dimen/qb_px_10"
                        android:layout_marginTop="@dimen/qb_px_5"
                        android:src="@mipmap/ic_desc"
                        android:layout_marginStart="@dimen/qb_px_5"/>
                </LinearLayout>
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/qb_px_30"
                    android:layout_below="@+id/ll_hr_value"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_time"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-30dp"
                    android:layout_below="@+id/chart1"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20">
                    <TextView
                        android:textSize="@dimen/qb_px_10"
                        android:textColor="@color/ring_activitypage_text_mask"
                        android:id="@+id/start_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:layout_marginStart="@dimen/qb_px_15"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/qb_px_10"
                        android:textColor="@color/ring_activitypage_text_mask"
                        android:id="@+id/end_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24:00"
                        android:layout_marginEnd="@dimen/qb_px_5"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_hr_value"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/qb_px_30"
                    android:layout_marginTop="@dimen/qb_px_25"
                    android:layout_below="@+id/tv_data_title"
                    android:layout_centerHorizontal="true"
                    android:layout_marginEnd="@dimen/qb_px_20"
                    android:layout_alignParentEnd="false">
                    <TextView
                        android:textSize="@dimen/qb_px_20"
                        android:textColor="?attr/colorOnPrimary"
                        android:id="@+id/tv_bo_currentvalue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:layout_below="@+id/tv_data_title"
                        android:layout_centerHorizontal="true"/>
                    <TextView
                        android:textSize="@dimen/qb_px_16"
                        android:textColor="@color/ring_activitypage_text_mask"
                        android:id="@+id/tv_bo_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:layout_below="@+id/tv_data_title"
                        android:layout_centerHorizontal="false"
                        android:layout_marginStart="@dimen/qb_px_10"
                        android:layout_toEndOf="@+id/tv_bo_currentvalue"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/shape_background_theme"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_110"
                android:layout_marginTop="@dimen/qb_px_20"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_centerVertical="true">
                            <TextView
                                android:textSize="@dimen/qb_px_16"
                                android:textColor="?attr/colorOnPrimary"
                                android:id="@+id/tv_bo_min"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"/>
                            <TextView
                                android:textSize="@dimen/qb_px_16"
                                android:textColor="@color/color_cccccc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/qb_px_10"
                                android:text="@string/ring_hr_min"/>
                        </LinearLayout>
                        <View
                            android:background="@color/ring_activitypage_text_mask"
                            android:layout_width="@dimen/qb_px_1"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/qb_px_35"
                            android:layout_marginBottom="@dimen/qb_px_35"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="@dimen/qb_px_16"
                                android:textColor="?attr/colorOnPrimary"
                                android:id="@+id/tv_bo_avg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"/>
                            <TextView
                                android:textSize="@dimen/qb_px_16"
                                android:textColor="@color/color_cccccc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/qb_px_10"
                                android:text="@string/ring_hr_ave"/>
                        </LinearLayout>
                        <View
                            android:background="@color/ring_activitypage_text_mask"
                            android:layout_width="@dimen/qb_px_1"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/qb_px_35"
                            android:layout_marginBottom="@dimen/qb_px_35"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_16"
                            android:textColor="?attr/colorOnPrimary"
                            android:id="@+id/tv_bo_max"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"/>
                        <TextView
                            android:textSize="@dimen/qb_px_16"
                            android:textColor="@color/color_cccccc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/qb_px_10"
                            android:text="@string/ring_hr_max"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_health_detaildata"
                android:background="@drawable/shape_background_theme"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_50"
                android:layout_marginTop="@dimen/qb_px_20"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_bo_detail_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ring_health_detail_title"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/qb_px_20"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ring_more_arrow"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/qb_px_20"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/shape_background_theme"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_110"
                android:layout_marginTop="@dimen/qb_px_20"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_realtime_data_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:text="@string/ring_bo_real_title"
                    android:lines="2"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_toStartOf="@+id/ll_realtime"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_realtime"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/qb_px_30"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:layout_centerHorizontal="false"
                    android:layout_marginEnd="@dimen/qb_px_20"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:layout_width="@dimen/qb_px_20"
                        android:layout_height="@dimen/qb_px_20"
                        android:src="@mipmap/ic_bloodoxygen"/>
                    <TextView
                        android:textSize="@dimen/qb_px_20"
                        android:textColor="?attr/colorOnPrimary"
                        android:id="@+id/tv_rt_bo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:layout_below="@+id/tv_data_title"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="@dimen/qb_px_20"/>
                    <TextView
                        android:textSize="@dimen/qb_px_16"
                        android:textColor="@color/ring_activitypage_text_mask"
                        android:id="@+id/tv_rt_hr_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:layout_below="@+id/tv_data_title"
                        android:layout_centerHorizontal="false"
                        android:layout_marginStart="@dimen/qb_px_10"
                        android:layout_toEndOf="@+id/tv_bo_currentvalue"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:gravity="center"
                    android:id="@+id/tv_start_test"
                    android:background="@drawable/shape_block_text_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_40"
                    android:layout_marginTop="@dimen/qb_px_15"
                    android:text="@string/ring_begin_measure"
                    android:layout_below="@+id/tv_realtime_data_title"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20"/>
            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_200"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
