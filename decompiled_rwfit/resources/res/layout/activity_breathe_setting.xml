<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@mipmap/ic_save"
        app:title_text="@string/str_breathe_title"/>
    <androidx.core.widget.NestedScrollView
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/switchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_name="@string/str_breathe_title"
                app:item_type="action_switch"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/firstTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="10:00"
                app:item_name="@string/str_first_time"
                app:item_type="action_info"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/secTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="12:00"
                app:item_name="@string/str_second_time"
                app:item_type="action_info"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/thTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="14:00"
                app:item_name="@string/str_third_time"
                app:item_type="action_info"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/fourTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="16:00"
                app:item_name="@string/str_fourth_time"
                app:item_type="action_info"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/fifthTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="18:00"
                app:item_name="@string/str_fifth_time"
                app:item_type="action_info"/>
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@color/color_cccccc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_8"
                android:text="@string/str_breathe_tips"
                android:layout_marginStart="@dimen/qb_px_16"
                android:layout_marginEnd="@dimen/qb_px_16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
