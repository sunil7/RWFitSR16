<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_text="@string/str_dial_custom"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/pane"
        app:layout_constraintTop_toBottomOf="@+id/titleView">
        <com.example.test.ui.view.DialLineaLayout
            android:orientation="vertical"
            android:id="@+id/content"
            android:paddingTop="@dimen/qb_px_16"
            android:paddingBottom="@dimen/qb_px_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/qb_px_10"
            android:paddingEnd="@dimen/qb_px_10">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/dianjiuceshi"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dial_layout"
                    android:layout_width="@dimen/qb_px_129"
                    android:layout_height="@dimen/qb_px_196"
                    android:layout_marginTop="@dimen/qb_px_20"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/dial_face"
                        android:layout_width="@dimen/qb_px_102"
                        android:layout_height="@dimen/qb_px_119"
                        android:layout_marginTop="@dimen/qb_px_38"
                        android:scaleType="fitXY"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/dial_cover"
                        android:background="@drawable/bg_dial_cover"
                        android:visibility="visible"
                        android:layout_width="@dimen/qb_px_102"
                        android:layout_height="@dimen/qb_px_119"
                        android:layout_marginTop="@dimen/qb_px_38"
                        android:scaleType="fitXY"
                        android:alpha="0"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/dial_widget_up"
                        android:background="@android:color/black"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_12"
                        app:layout_constraintLeft_toLeftOf="@+id/dial_cover"
                        app:layout_constraintRight_toRightOf="@+id/dial_cover"
                        app:layout_constraintTop_toTopOf="@+id/dial_cover"/>
                    <View
                        android:id="@+id/dial_widget_down"
                        android:background="@android:color/black"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/qb_px_12"
                        app:layout_constraintBottom_toBottomOf="@+id/dial_cover"
                        app:layout_constraintLeft_toLeftOf="@+id/dial_cover"
                        app:layout_constraintRight_toRightOf="@+id/dial_cover"/>
                    <com.example.test.ui.view.DialWidgetView
                        android:id="@+id/dial_widget"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_12"
                        app:layout_constraintLeft_toLeftOf="@+id/dial_cover"
                        app:layout_constraintRight_toRightOf="@+id/dial_cover"
                        app:layout_constraintTop_toTopOf="@+id/dial_cover"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/qb_px_24"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:layout_marginBottom="@dimen/qb_px_6"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dial_layout">
                    <TextView
                        android:textSize="@dimen/qb_px_16"
                        android:textColor="@color/color_293040"
                        android:id="@+id/select_pic"
                        android:background="@drawable/selector_indicator_button"
                        android:paddingTop="@dimen/qb_px_4"
                        android:paddingBottom="@dimen/qb_px_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_select_picture"
                        android:paddingStart="@dimen/qb_px_8"
                        android:paddingEnd="@dimen/qb_px_8"/>
                    <TextView
                        android:textSize="@dimen/qb_px_16"
                        android:textColor="@color/color_293040"
                        android:id="@+id/recover_normal"
                        android:background="@drawable/selector_indicator_button"
                        android:paddingTop="@dimen/qb_px_4"
                        android:paddingBottom="@dimen/qb_px_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_restore_default"
                        android:paddingStart="@dimen/qb_px_8"
                        android:paddingEnd="@dimen/qb_px_8"
                        android:layout_marginStart="@dimen/qb_px_60"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/time_position_layout"
                android:paddingBottom="@dimen/qb_px_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_24"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_10">
                <TextView
                    android:textColor="@color/color_e6e6e6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/str_time_position"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/time_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_time_up"
                    android:layout_marginEnd="@dimen/qb_px_16"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_arrow_right"/>
            </LinearLayout>
            <View
                android:background="@color/color_293040"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/fun_time_up"
                android:paddingBottom="@dimen/qb_px_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_16"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_10">
                <TextView
                    android:textColor="@color/color_e6e6e6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/str_time_up"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/time_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/qb_px_16"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_arrow_right"/>
            </LinearLayout>
            <View
                android:background="@color/color_293040"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/fun_time_down"
                android:paddingBottom="@dimen/qb_px_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_16"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_10">
                <TextView
                    android:textColor="@color/color_e6e6e6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/str_time_down"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/time_down"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/qb_px_16"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_arrow_right"/>
            </LinearLayout>
            <View
                android:background="@color/color_293040"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_16"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_10">
                <TextView
                    android:textColor="@color/color_e6e6e6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_text_color"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/color_list"
                    android:paddingTop="@dimen/qb_px_10"
                    android:paddingBottom="@dimen/qb_px_10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/color_e6e6e6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_picture_brightness"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_marginEnd="@dimen/dp_10"/>
                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/cover_alpha_seekbar"
                    android:background="@android:color/transparent"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="100"
                    android:secondaryProgress="100"
                    android:progressDrawable="@drawable/seekbar_progress_drawable"
                    android:thumb="@drawable/bg_thumb"
                    android:paddingStart="@dimen/qb_px_20"
                    android:paddingEnd="@dimen/qb_px_20"
                    android:splitTrack="false"/>
            </LinearLayout>
        </com.example.test.ui.view.DialLineaLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/pane"
        android:background="@color/colorPrimaryDark"
        android:padding="@dimen/qb_px_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <com.example.test.ui.view.ProgressButtonView
            android:id="@+id/progressBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_50"
            app:button_text_size="@dimen/qb_px_16"/>
    </LinearLayout>
</LinearLayout>
