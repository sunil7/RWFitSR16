<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_293040"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_text="@string/str_dial_custom"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/main_dial"
        android:layout_width="160dp"
        android:layout_height="190dp"
        android:layout_marginTop="10dp"/>
    <View
        android:id="@+id/line1"
        android:background="@color/color_131825"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_dial"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <com.example.test.ui.view.DialLineaLayout
            android:orientation="vertical"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/color_e6e6e6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_dial_background"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/background_list"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>
                <View
                    android:background="@color/color_131825"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="10dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/color_e6e6e6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_dial_placement"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/placement_list"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>
                <View
                    android:background="@color/color_131825"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="15dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/color_e6e6e6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_dial_text_color"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/text_colour_list"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>
                <View
                    android:background="@color/color_131825"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="10dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/color_e6e6e6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_dial_text_font"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/text_font_list"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp"/>
            </LinearLayout>
        </com.example.test.ui.view.DialLineaLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/pane"
        android:background="@color/colorPrimaryDark"
        android:padding="@dimen/qb_px_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.example.test.ui.view.ProgressButtonView
            android:id="@+id/progressBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_50"
            app:button_text_size="@dimen/qb_px_16"/>
    </LinearLayout>
</LinearLayout>
