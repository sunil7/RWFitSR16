<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="调试页面"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/av_share_device_log"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="测试功能-分享日志"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/av_share_device_db"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="测试功能-分享数据库"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/av_share_device_synclog"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="测试功能-同步睡眠日志  (戒指勿点)"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_factory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/tv_factory_open"
            android:background="@drawable/selector_button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="工厂模式-开"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/tv_factory_close"
            android:background="@drawable/selector_button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:text="工厂模式-关"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
