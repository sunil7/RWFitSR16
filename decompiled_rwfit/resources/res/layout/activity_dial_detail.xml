<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/str_dial_detail"/>
    <LinearLayout
        android:gravity="center"
        android:background="@color/color_293040"
        android:padding="@dimen/qb_px_40"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:textSize="@dimen/qb_px_16"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dial_face"
            android:layout_width="@dimen/qb_px_120"
            android:layout_height="@dimen/qb_px_160"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/qb_px_24">
        <TextView
            android:textSize="@dimen/qb_px_16"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/dial_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10">
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@android:color/holo_orange_light"
                android:id="@+id/free"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_dial_free"/>
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@android:color/holo_green_light"
                android:id="@+id/dial_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|  200KB"
                android:layout_marginStart="@dimen/qb_px_10"/>
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@android:color/white"
                android:gravity="right"
                android:id="@+id/install"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_20"
            android:text="@string/str_notes"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/qb_px_20"
            android:text="@string/str_notes_dial"
            android:layout_weight="1"/>
        <com.example.test.ui.view.ProgressButtonView
            android:id="@+id/progressBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_50"
            android:layout_marginBottom="@dimen/qb_px_10"
            app:button_text_size="@dimen/qb_px_16"/>
    </LinearLayout>
</LinearLayout>
