<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@drawable/svg_family_friend_plus"
        app:title_text="@string/ring_item_family_affection"
        app:title_text_color="?attr/colorOnPrimary"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/srl_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/no_friend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/no_friend_linear"
                android:visibility="gone"
                android:layout_width="180dp"
                android:layout_height="150dp"
                android:layout_marginBottom="@dimen/dp_10"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/family_no_friend"
                    android:scaleType="centerInside"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/qb_px_20"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                android:id="@+id/no_friend_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_family_friend_none"
                android:layout_below="@+id/no_friend_linear"
                android:layout_centerInParent="true"/>
            <com.example.test.ui.view.FamilyFriendRecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
