<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.testui.TRingToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_option2="@drawable/svg_ic_tb_refresh"
        app:bar_status_res="@drawable/svg_ic_tb_back"
        app:bar_title="@string/str_family_sport_data"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.example.test.ui.testui.TRingDateSelectView
        android:id="@+id/view_date_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/step_content"
        android:background="@mipmap/homepage_step_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_250"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <com.example.test.ui.view.HalfCircle
            android:layout_gravity="center_horizontal"
            android:id="@+id/step_progress"
            android:layout_width="@dimen/qb_px_220"
            android:layout_height="@dimen/qb_px_220"
            android:layout_marginTop="@dimen/qb_px_30"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="false"
            android:layout_alignParentEnd="false"
            app:bg_color="@color/ring_progress_bg"
            app:fore_color="@color/color_white"
            app:radius_len="40dp"
            app:text_str=""
            app:txt_size="40sp"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/tv_desc"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_70"
            android:text="活动活跃"
            android:lines="2"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/qb_px_12"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="@dimen/qb_px_20"
                    android:layout_height="@dimen/qb_px_20"
                    android:src="@mipmap/ic_step_kilo"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_cal"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@color/color_white"
                    android:id="@+id/tv_calorie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00KCAL"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="@dimen/qb_px_20"
                    android:layout_height="@dimen/qb_px_20"
                    android:src="@mipmap/ic_step_step"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_target"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@color/color_white"
                    android:id="@+id/tv_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--步"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="@dimen/qb_px_20"
                    android:layout_height="@dimen/qb_px_20"
                    android:src="@mipmap/ic_step_km"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_distance"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@color/color_white"
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00KM"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/family_sport_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
