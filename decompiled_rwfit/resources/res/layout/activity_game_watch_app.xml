<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@drawable/svg_confirmdialog_ok"
        app:title_text="@string/str_dial_setting_item_appcontrol"
        app:title_text_color="?attr/colorOnPrimary"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/childapp_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:is_show_icon="false"
            app:item_name="@string/str_select_all"
            app:item_type="action_switch"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/notify_per_enable_view_1"
            android:visibility="visible"
            android:layout_width="@dimen/qb_px_56"
            android:layout_height="@dimen/dp_40"
            app:layout_constraintBottom_toBottomOf="@+id/childapp_all"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/childapp_all"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_game"
        android:paddingBottom="@dimen/qb_px_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/childapp_game"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:is_show_icon="false"
            app:item_name="@string/str_dial_item_appcontrol_1"
            app:item_type="action_switch"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/notify_per_enable_view_2"
            android:layout_width="@dimen/qb_px_56"
            android:layout_height="@dimen/dp_40"
            app:layout_constraintBottom_toBottomOf="@+id/childapp_game"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/childapp_game"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_bedtimestory"
        android:paddingBottom="@dimen/qb_px_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/childapp_bedtimestory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:is_show_icon="false"
            app:item_name="@string/str_dial_item_appcontrol_2"
            app:item_type="action_switch"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/notify_per_enable_view_3"
            android:layout_width="@dimen/qb_px_56"
            android:layout_height="@dimen/dp_40"
            app:layout_constraintBottom_toBottomOf="@+id/childapp_bedtimestory"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/childapp_bedtimestory"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_music"
        android:paddingBottom="@dimen/qb_px_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/childapp_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:is_show_icon="false"
            app:item_name="@string/str_dial_item_appcontrol_3"
            app:item_type="action_switch"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/notify_per_enable_view_4"
            android:layout_width="@dimen/qb_px_56"
            android:layout_height="@dimen/dp_40"
            app:layout_constraintBottom_toBottomOf="@+id/childapp_music"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/childapp_music"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_learningcards"
        android:paddingBottom="@dimen/qb_px_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/childapp_learningcards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:is_show_icon="false"
            app:item_name="@string/str_dial_item_appcontrol_4"
            app:item_type="action_switch"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/notify_per_enable_view_5"
            android:layout_width="@dimen/qb_px_56"
            android:layout_height="@dimen/dp_40"
            app:layout_constraintBottom_toBottomOf="@+id/childapp_learningcards"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/childapp_learningcards"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_audiobook"
        android:paddingBottom="@dimen/qb_px_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/childapp_audiobook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:is_show_icon="false"
            app:item_name="@string/str_dial_item_appcontrol_5"
            app:item_type="action_switch"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/notify_per_enable_view_6"
            android:layout_width="@dimen/qb_px_56"
            android:layout_height="@dimen/dp_40"
            app:layout_constraintBottom_toBottomOf="@+id/childapp_audiobook"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/childapp_audiobook"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
