<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/ring_item_healthmonitor_title"
        app:title_text_color="?attr/colorOnPrimary"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_health_heart"
            android:background="@drawable/bg_ring_item"
            android:paddingTop="@dimen/qb_px_10"
            android:paddingBottom="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textColor="?attr/colorOnPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ring_monitor_hr_watcher"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_toStartOf="@+id/tv_health_hr_value"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/ivNext"
                android:layout_width="@dimen/qb_px_9"
                android:layout_height="@dimen/qb_px_16"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_15"
                android:layout_alignParentEnd="true"
                app:srcCompat="@mipmap/ic_arrow_right"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_828282"
                android:id="@+id/tv_health_hr_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_ring_screen_light_0"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_5"
                android:layout_toStartOf="@+id/ivNext"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_health_oo"
            android:background="@drawable/bg_ring_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_15">
            <TextView
                android:textSize="18sp"
                android:textColor="?attr/colorOnPrimary"
                android:id="@+id/tv_health_oo_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_5"
                android:text="@string/ring_bo_watcher"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_toStartOf="@+id/scBtn_oo"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/scBtn_oo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_15"
                android:layout_alignParentEnd="true"
                app:thumbTint="@color/ring_bottomtext_sel"
                app:trackTint="@drawable/ring_switch_track_color"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_828282"
                android:id="@+id/tv_health_oo_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_2"
                android:layout_marginBottom="@dimen/qb_px_15"
                android:text="@string/ring_stress_watcher_subtitle"
                android:layout_below="@+id/tv_health_oo_title"
                android:layout_alignStart="@+id/tv_health_oo_title"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_health_hrv"
            android:background="@drawable/bg_ring_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_15">
            <TextView
                android:textSize="18sp"
                android:textColor="?attr/colorOnPrimary"
                android:id="@+id/tv_health_hrv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_5"
                android:text="@string/ring_hrv_watcher"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_toStartOf="@+id/scBtn_hrv"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/scBtn_hrv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_15"
                android:layout_alignParentEnd="true"
                app:thumbTint="@color/ring_bottomtext_sel"
                app:trackTint="@drawable/ring_switch_track_color"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_828282"
                android:id="@+id/tv_health_hrv_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_2"
                android:layout_marginBottom="@dimen/qb_px_15"
                android:text="@string/ring_stress_watcher_subtitle"
                android:layout_below="@+id/tv_health_hrv_title"
                android:layout_alignStart="@+id/tv_health_hrv_title"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_health_stress"
            android:background="@drawable/bg_ring_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_15">
            <TextView
                android:textSize="18sp"
                android:textColor="?attr/colorOnPrimary"
                android:id="@+id/tv_health_stress_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_5"
                android:text="@string/ring_stress_watcher"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_toStartOf="@+id/scBtn_stress"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/scBtn_stress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_15"
                android:layout_alignParentEnd="true"
                app:thumbTint="@color/ring_bottomtext_sel"
                app:trackTint="@drawable/ring_switch_track_color"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_828282"
                android:id="@+id/tv_health_stress_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_2"
                android:layout_marginBottom="@dimen/qb_px_15"
                android:text="@string/ring_stress_watcher_subtitle"
                android:layout_below="@+id/tv_health_stress_title"
                android:layout_alignStart="@+id/tv_health_stress_title"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_health_bloodsugar"
            android:background="@drawable/bg_ring_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_15">
            <TextView
                android:textSize="18sp"
                android:textColor="?attr/colorOnPrimary"
                android:id="@+id/tv_health_bloodsugar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_5"
                android:text="@string/ring_bloodsugar_watcher"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_toStartOf="@+id/scBtn_bloodsugar"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/scBtn_bloodsugar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_15"
                android:layout_alignParentEnd="true"
                app:thumbTint="@color/ring_bottomtext_sel"
                app:trackTint="@drawable/ring_switch_track_color"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_828282"
                android:id="@+id/tv_health_bloodsugar_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_2"
                android:layout_marginBottom="@dimen/qb_px_15"
                android:text="@string/ring_stress_watcher_subtitle"
                android:layout_below="@+id/tv_health_bloodsugar_title"
                android:layout_alignStart="@+id/tv_health_bloodsugar_title"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_health_bp"
            android:background="@drawable/bg_ring_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_15">
            <TextView
                android:textSize="18sp"
                android:textColor="?attr/colorOnPrimary"
                android:id="@+id/tv_health_bp_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_5"
                android:text="@string/ring_bp_watcher"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_toStartOf="@+id/scBtn_bp"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/scBtn_bp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_15"
                android:layout_alignParentEnd="true"
                app:thumbTint="@color/ring_bottomtext_sel"
                app:trackTint="@drawable/ring_switch_track_color"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_828282"
                android:id="@+id/tv_health_bp_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_2"
                android:layout_marginBottom="@dimen/qb_px_15"
                android:text="@string/ring_stress_watcher_subtitle"
                android:layout_below="@+id/tv_health_bp_title"
                android:layout_alignStart="@+id/tv_health_bp_title"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
