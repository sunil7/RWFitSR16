<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.testui.TRingToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_status_res="@drawable/svg_ic_tb_back"
        app:bar_title="@string/str_bo_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_20"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:background="@drawable/shape_background_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/qb_px_10"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_hrdesc_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:layout_marginBottom="@dimen/qb_px_20"
                    android:text="@string/str_scien_tips"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_hr_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_hrdesc_title"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/qb_px_30">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@color/ring_activitypage_text_mask"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_range_hr"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@color/ring_activitypage_text_mask"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="60-100bpm"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"/>
                        <View
                            android:background="@color/ring_activitypage_text_mask"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/qb_px_1"
                            android:layout_alignParentBottom="true"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/qb_px_30">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@color/ring_activitypage_text_mask"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_fast_hr"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@color/ring_activitypage_text_mask"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&gt;100bpm"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"/>
                        <View
                            android:background="@color/ring_activitypage_text_mask"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/qb_px_1"
                            android:layout_alignParentBottom="true"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/qb_px_30">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@color/ring_activitypage_text_mask"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_slow_hr"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@color/ring_activitypage_text_mask"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&lt;60bpm"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"/>
                        <View
                            android:background="@color/ring_activitypage_text_mask"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/qb_px_1"
                            android:layout_alignParentBottom="true"/>
                    </RelativeLayout>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:layout_marginBottom="@dimen/qb_px_30"
                    android:text="@string/str_hr_description"
                    android:layout_below="@+id/ll_hr_desc"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20"/>
            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_200"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
