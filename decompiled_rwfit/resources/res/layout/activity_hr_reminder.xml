<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/str_heart_rate_reminder_title"
        app:title_text_color="?attr/colorOnPrimary"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_health_bloodsugar"
            android:background="@drawable/bg_ring_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_15"
            android:layout_marginBottom="@dimen/qb_px_20">
            <TextView
                android:textSize="18sp"
                android:textColor="?attr/colorOnPrimary"
                android:id="@+id/tv_health_bloodsugar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_5"
                android:text="@string/str_heart_rate_reminder_title"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_toStartOf="@+id/reminder_switch"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/reminder_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_15"
                android:layout_alignParentEnd="true"
                app:thumbTint="@color/ring_bottomtext_sel"
                app:trackTint="@drawable/ring_switch_track_color"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_828282"
                android:id="@+id/tv_health_bloodsugar_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_2"
                android:layout_marginBottom="@dimen/qb_px_15"
                android:text="@string/str_heart_rate_reminder_content"
                android:layout_below="@+id/tv_health_bloodsugar_title"
                android:paddingEnd="@dimen/qb_px_60"
                android:layout_alignStart="@+id/tv_health_bloodsugar_title"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_health_heart"
            android:background="@drawable/bg_ring_item"
            android:paddingTop="@dimen/qb_px_10"
            android:paddingBottom="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textColor="?attr/colorOnPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_exceed_reminder"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_toStartOf="@+id/tv_health_hr_value"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/ivNext"
                android:layout_width="@dimen/qb_px_9"
                android:layout_height="@dimen/qb_px_16"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_15"
                android:layout_alignParentEnd="true"
                app:srcCompat="@mipmap/ic_arrow_right"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_828282"
                android:id="@+id/tv_health_hr_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="70"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_5"
                android:layout_toStartOf="@+id/ivNext"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
