<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@drawable/svg_confirmdialog_ok"
        app:title_text="@string/str_nick"/>
    <EditText
        android:textColor="?attr/colorOnPrimary"
        android:textColorHint="@color/color_cccccc"
        android:id="@+id/editEt"
        android:background="@drawable/bg_item_theme"
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/str_nick"
        android:maxLength="20"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="?attr/colorOnPrimary"
        android:gravity="end"
        android:id="@+id/limitTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        android:text="0/20"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_0"
        android:layout_weight="0"/>
    <Button
        android:enabled="false"
        android:textSize="@dimen/qb_px_14"
        android:id="@+id/sureBtn"
        android:background="@drawable/selector_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qb_px_44"
        android:text="@string/str_sure"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"/>
    <TextView
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/tv_btname_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/str_ring_btname_tip"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp"/>
</LinearLayout>
