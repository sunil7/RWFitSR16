<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleViewMiddle
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/str_login"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/appLogo"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_100"
        android:layout_height="@dimen/qb_px_100"
        android:layout_marginTop="@dimen/dp_40"
        android:src="@mipmap/ic_launcher_foreground"/>
    <com.example.test.ui.view.InputView
        android:id="@+id/accountInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_38"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:input_hint="@string/str_account"
        app:input_icon="@mipmap/ic_account"/>
    <com.example.test.ui.view.InputView
        android:id="@+id/pwInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:input_action_img_show="@mipmap/ic_disvisiable"
        app:input_hint="@string/str_password"
        app:input_icon="@mipmap/ic_pw"
        app:input_is_pw="true"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:id="@+id/tvReadProtocol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        android:text="我已阅读并同意《用户协议》、《隐私协议》"
        android:paddingStart="@dimen/qb_px_16"
        android:paddingEnd="@dimen/qb_px_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProContent"/>
    <Button
        android:enabled="false"
        android:textColor="@android:color/white"
        android:id="@+id/btnLogin"
        android:background="@drawable/selector_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_28"
        android:text="@string/str_login"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10">
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@color/colorAccent"
            android:id="@+id/tvForgetPw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_forget_pw"
            android:layout_marginEnd="@dimen/qb_px_10"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@android:color/white"
            android:gravity="right"
            android:id="@+id/tvHasNotAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/str_has_not_account"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_56"
            android:paddingStart="@dimen/qb_px_30"
            android:paddingEnd="@dimen/qb_px_30"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@android:color/white"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/qb_px_8"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_other_login"/>
                <View
                    android:background="@android:color/white"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/qb_px_8"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_20">
                <ImageView
                    android:gravity="center"
                    android:id="@+id/wxIv"
                    android:layout_width="@dimen/qb_px_56"
                    android:layout_height="@dimen/qb_px_56"
                    android:src="@mipmap/ic_wechat_login"
                    android:text="谷歌"/>
                <ImageView
                    android:gravity="center"
                    android:id="@+id/qqIv"
                    android:layout_width="@dimen/qb_px_56"
                    android:layout_height="@dimen/qb_px_56"
                    android:src="@mipmap/ic_qq_login"
                    android:text="face"
                    android:layout_marginStart="@dimen/qb_px_16"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
