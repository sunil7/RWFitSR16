<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@mipmap/ic_save"
        app:title_text="@string/str_warn_model"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never">
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/mens_remind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:is_show_icon="false"
                app:item_name="@string/str_remind_menstrual_period"
                app:item_type="action_switch"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/ovulation_remind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_name="@string/str_remind_ovulation_period"
                app:item_type="action_switch"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/ovulation__high_remind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_name="@string/str_remind_ovulation_peak"
                app:item_type="action_switch"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/ovulation_finish_remind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_name="@string/str_remind_ovulation_end"
                app:item_type="action_switch"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
