<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@drawable/svg_confirmdialog_ok"
        app:title_text="@string/str_msg_push"
        app:title_text_color="?attr/colorOnPrimary"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/notify_iv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:is_show_icon="false"
            app:item_name="@string/str_notify_permisson"
            app:item_type="action_switch"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/notify_per_enable_view"
            android:visibility="visible"
            android:layout_width="@dimen/qb_px_56"
            android:layout_height="@dimen/dp_40"
            app:layout_constraintBottom_toBottomOf="@+id/notify_iv"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/notify_iv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="?attr/colorOnPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_10"
        android:text="@string/str_notify_tips"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/notify_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:item_name="@string/str_select_all"
            app:item_resource="@mipmap/ic_select_all"
            app:item_type="action_switch"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/notify_per_enable_view_1"
            android:visibility="visible"
            android:layout_width="@dimen/qb_px_56"
            android:layout_height="@dimen/dp_40"
            app:layout_constraintBottom_toBottomOf="@+id/notify_all"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/notify_all"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"/>
</LinearLayout>
