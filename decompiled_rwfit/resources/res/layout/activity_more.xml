<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/str_more"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/fun_recovery"
        android:paddingBottom="@dimen/qb_px_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_46"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        android:layout_marginStart="@dimen/qb_px_16"
        android:layout_marginEnd="@dimen/qb_px_16">
        <TextView
            android:textColor="@color/color_e6e6e6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/str_recover"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_arrow_right"/>
    </LinearLayout>
    <View
        android:id="@+id/line1"
        android:background="@color/color_293040"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/fun_restart"
        android:paddingBottom="@dimen/qb_px_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_21"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        android:layout_marginStart="@dimen/qb_px_16"
        android:layout_marginEnd="@dimen/qb_px_16">
        <TextView
            android:textColor="@color/color_e6e6e6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/str_device_restart"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_arrow_right"/>
    </LinearLayout>
    <View
        android:id="@+id/line2"
        android:background="@color/color_293040"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/fun_power_off"
        android:paddingBottom="@dimen/qb_px_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_21"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        android:layout_marginStart="@dimen/qb_px_16"
        android:layout_marginEnd="@dimen/qb_px_16">
        <TextView
            android:textColor="@color/color_e6e6e6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/str_device_shutdown"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_arrow_right"/>
    </LinearLayout>
    <View
        android:id="@+id/line3"
        android:background="@color/color_293040"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"/>
</LinearLayout>
