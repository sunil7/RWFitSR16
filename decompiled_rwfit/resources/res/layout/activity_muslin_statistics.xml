<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintLayout"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.testui.TRingToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_option1="@drawable/svg_ic_activitypage_share"
        app:bar_status_res="@drawable/svg_ic_tb_back"
        app:bar_title="@string/ring_muslimcount_detail_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.example.test.ui.testui.TRingDateSelectView
        android:id="@+id/view_date_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <ScrollView
        android:id="@+id/sv_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_date_select">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_step_num"
                android:background="@drawable/shape_background_theme"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_250"
                android:layout_marginTop="@dimen/qb_px_20"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_muslin_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="@string/ring_muslimcount_title"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/qb_px_15"
                    android:layout_toStartOf="@+id/ll_desc"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="false"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_desc"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/qb_px_30"
                    android:layout_marginTop="@dimen/qb_px_25"
                    android:layout_marginEnd="@dimen/qb_px_20"
                    android:layout_alignParentEnd="true">
                    <TextView
                        android:textSize="@dimen/qb_px_12"
                        android:textColor="@color/ring_desctext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ring_hr_readme"/>
                    <ImageView
                        android:layout_width="@dimen/qb_px_10"
                        android:layout_height="@dimen/qb_px_10"
                        android:layout_marginTop="@dimen/qb_px_5"
                        android:src="@mipmap/ic_desc"
                        android:layout_marginStart="@dimen/qb_px_5"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/qb_px_36"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_step_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_40"
                    android:text="--"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="@dimen/qb_px_10"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:gravity="center"
                    android:id="@+id/tv_step_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_count"
                    android:layout_alignTop="@+id/tv_step_num"
                    android:layout_alignBottom="@+id/tv_step_num"
                    android:layout_marginStart="@dimen/qb_px_10"
                    android:layout_toEndOf="@+id/tv_step_num"/>
                <RelativeLayout
                    android:id="@+id/rl_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_150"
                    android:layout_marginBottom="@dimen/qb_px_25"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20">
                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chart1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <com.example.test.ui.view.TimeIndicatorView
                        android:id="@+id/ll_time"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-12dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <com.example.test.ui.view.WaveView
                    android:id="@+id/wv_progress"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_230"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/qb_px_30"
                    android:layout_marginEnd="@dimen/qb_px_30"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/shape_background_theme"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_110"
                android:layout_marginTop="@dimen/qb_px_20"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_centerVertical="true">
                            <TextView
                                android:textSize="@dimen/qb_px_16"
                                android:textColor="?attr/colorOnPrimary"
                                android:id="@+id/tv_hr_min"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"/>
                            <TextView
                                android:textSize="@dimen/qb_px_16"
                                android:textColor="@color/color_cccccc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/qb_px_10"
                                android:text="@string/ring_hr_min"/>
                        </LinearLayout>
                        <View
                            android:background="@color/ring_activitypage_text_mask"
                            android:layout_width="@dimen/qb_px_1"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/qb_px_35"
                            android:layout_marginBottom="@dimen/qb_px_35"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="@dimen/qb_px_16"
                                android:textColor="?attr/colorOnPrimary"
                                android:id="@+id/tv_hr_avg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"/>
                            <TextView
                                android:textSize="@dimen/qb_px_16"
                                android:textColor="@color/color_cccccc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/qb_px_10"
                                android:text="@string/ring_hr_ave"/>
                        </LinearLayout>
                        <View
                            android:background="@color/ring_activitypage_text_mask"
                            android:layout_width="@dimen/qb_px_1"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/qb_px_35"
                            android:layout_marginBottom="@dimen/qb_px_35"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_16"
                            android:textColor="?attr/colorOnPrimary"
                            android:id="@+id/tv_hr_max"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"/>
                        <TextView
                            android:textSize="@dimen/qb_px_16"
                            android:textColor="@color/color_cccccc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/qb_px_10"
                            android:text="@string/ring_hr_max"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="200dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
