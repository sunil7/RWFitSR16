<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@mipmap/ic_share"
        app:title_text="@string/str_qrcode"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_item_theme"
            android:padding="@dimen/qb_px_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_10">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/avatarIv"
                    android:layout_width="@dimen/qb_px_86"
                    android:layout_height="@dimen/qb_px_86"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/userNameTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_unset"
                    android:layout_marginStart="@dimen/qb_px_10"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/qrCodeIv"
                android:layout_width="@dimen/qb_px_168"
                android:layout_height="@dimen/qb_px_168"
                android:layout_marginTop="@dimen/qb_px_24"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/colorOnPrimary"
                android:id="@+id/tv_user_id"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:text="ID:"
                android:maxLines="2"
                android:textAlignment="center"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/qb_px_24">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_step"/>
                        <TextView
                            android:textSize="@dimen/qb_px_12"
                            android:textColor="@color/color_cccccc"
                            android:id="@+id/totalStepTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--步"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_cal"/>
                        <TextView
                            android:textSize="@dimen/qb_px_12"
                            android:textColor="@color/color_cccccc"
                            android:id="@+id/calorieTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00KCAL"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_distance"/>
                        <TextView
                            android:textSize="@dimen/qb_px_12"
                            android:textColor="@color/color_cccccc"
                            android:id="@+id/distanceTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00KM"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textColor="?attr/colorOnPrimary"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_join_me"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
