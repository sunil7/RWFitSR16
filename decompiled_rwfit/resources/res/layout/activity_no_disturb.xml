<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@mipmap/ic_save"
        app:title_text="@string/str_no_disturb"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/allDayDndAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:is_show_icon="false"
            app:item_name="@string/str_do_not_disturb_allday"
            app:item_type="action_switch"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/dndAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:is_show_icon="false"
            app:item_name="@string/str_do_not_disturb_timing"
            app:item_type="action_switch"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/startTimeAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:is_show_icon="false"
            app:item_hint="00:00"
            app:item_name="@string/str_start_time"
            app:item_type="action_info"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/endTimeAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:is_show_icon="false"
            app:item_hint="00:00"
            app:item_name="@string/str_end_time"
            app:item_type="action_info"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@color/color_cccccc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            android:text="@string/str_no_disturb_tips"
            android:layout_marginStart="@dimen/qb_px_16"
            android:layout_marginEnd="@dimen/qb_px_16"/>
    </LinearLayout>
</LinearLayout>
