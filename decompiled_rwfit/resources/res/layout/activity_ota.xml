<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/str_ota"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_ring_item"
                android:padding="@dimen/qb_px_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="@dimen/qb_px_100"
                    android:layout_height="@dimen/qb_px_100"
                    android:src="@mipmap/firmware_update"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_current_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_12"
                    android:layout_marginBottom="@dimen/qb_px_10"
                    android:text="@string/str_ota_current_version"/>
                <View
                    android:background="@android:color/darker_gray"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:text="@string/str_ota_info"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_firmware_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_6"
                    android:text="@string/str_ota_version"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_firmware_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_6"
                    android:text="@string/str_ota_filesize"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_firmware_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_6"
                    android:text="@string/str_ota_update_message"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_ring_item"
                android:padding="@dimen/qb_px_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:text="@string/str_notes"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/updateNotice"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="@string/str_notes_ota"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.example.test.ui.view.ProgressButtonView
        android:id="@+id/progressBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_50"
        android:layout_margin="@dimen/qb_px_10"
        android:layout_marginBottom="@dimen/qb_px_10"
        app:button_text_size="@dimen/qb_px_16"/>
</LinearLayout>
