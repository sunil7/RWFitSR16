<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.testui.TRingToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_status_res="@drawable/svg_ic_tb_back"
        app:bar_title="@string/ring_menstrual_cycle_setting"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_action"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.example.test.ui.view.ActionItemView
                    android:id="@+id/range_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    app:is_show_icon="false"
                    app:item_hint="28"
                    app:item_name="@string/str_cycle_days"
                    app:item_type="action_info"/>
                <com.example.test.ui.view.ActionItemView
                    android:id="@+id/menstrual_period"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    app:is_show_icon="false"
                    app:item_hint="5"
                    app:item_name="@string/str_menstrual_days"
                    app:item_type="action_info"/>
                <com.example.test.ui.view.ActionItemView
                    android:id="@+id/last_mens_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    app:is_show_icon="false"
                    app:item_hint="2022/11/05"
                    app:item_name="@string/str_menstrual_last_time"
                    app:item_type="action_info"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
