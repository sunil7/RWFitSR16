<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.testui.TRingToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_option1="@drawable/svg_ic_menu_settings"
        app:bar_status_res="@drawable/svg_ic_tb_back"
        app:bar_title="@string/ring_menstrual_cycle_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_period_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/point_red"/>
        <TextView
            android:textSize="@dimen/qb_px_16"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ring_women_jingqi"
            android:layout_marginStart="@dimen/qb_px_5"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/point_purple"
            android:layout_marginStart="@dimen/qb_px_20"/>
        <TextView
            android:textSize="@dimen/qb_px_16"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ring_women_pailuanqi"
            android:layout_marginStart="@dimen/qb_px_5"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_20"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_period_style">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/qb_px_16"
                android:textColor="?attr/colorOnPrimary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="month"
                android:layout_marginStart="@dimen/qb_px_5"/>
            <com.haibin.calendarview.CalendarLayout
                android:orientation="vertical"
                android:id="@+id/calendar_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:calendar_show_mode="only_month_view"
                app:default_status="shrink"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_date_select">
                <com.haibin.calendarview.CalendarView
                    android:id="@+id/calendarView"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    app:calendar_height="44dp"
                    app:calendar_padding="5dp"
                    app:current_day_text_color="?attr/colorOnPrimary"
                    app:current_month_text_color="?attr/colorOnPrimary"
                    app:day_text_size="14sp"
                    app:max_year_month="12"
                    app:min_year="2024"
                    app:min_year_month="1"
                    app:month_view="com.example.test.ui.view.calendar.CustomRangeMonthView"
                    app:month_view_scrollable="true"
                    app:month_view_show_mode="mode_all"
                    app:other_month_text_color="@color/color_3cfff"
                    app:scheme_text_color="@color/color_3cfff"
                    app:selected_text_color="?attr/colorOnPrimary"
                    app:selected_theme_color="@color/color_3cfff"
                    app:week_background="@null"
                    app:week_bar_height="@dimen/qb_px_24"
                    app:week_bar_view="com.example.test.ui.view.calendar.CustomWeekBar"
                    app:week_line_margin="1dp"
                    app:week_text_color="?attr/colorOnPrimary"
                    app:week_text_size="12sp"
                    app:week_view="com.example.test.ui.view.calendar.SimpleWeekView"
                    app:year_view_week_height="@dimen/qb_px_28"/>
            </com.haibin.calendarview.CalendarLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_200"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
