<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@drawable/svg_confirmdialog_ok"
        app:title_text="@string/str_personal_data"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/qb_px_10"
        android:paddingEnd="@dimen/qb_px_10">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/avatarLl"
                android:background="@drawable/bg_item_theme"
                android:padding="@dimen/qb_px_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/itemName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/str_user_avatar"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/qb_px_10"/>
                <ImageView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/avatarIv"
                    android:background="@drawable/bg_circle_yellow"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:text="头像"/>
                <ImageView
                    android:id="@+id/ivNext"
                    android:padding="@dimen/qb_px_4"
                    android:layout_width="@dimen/qb_px_18"
                    android:layout_height="@dimen/qb_px_24"
                    android:layout_marginStart="@dimen/qb_px_8"
                    app:srcCompat="@mipmap/ic_arrow_right"/>
            </LinearLayout>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/nickNameAv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="user4646516454"
                app:item_name="@string/str_nick"
                app:item_type="action_info"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/sexAv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="男"
                app:item_name="@string/str_sex"
                app:item_type="action_info"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/birthdayAv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="2022/10/11"
                app:item_name="@string/str_birthday"
                app:item_type="action_info"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/heightAv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="170cm"
                app:item_name="@string/str_height"
                app:item_type="action_info"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/weightAv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="60.0kg"
                app:item_name="@string/str_weight"
                app:item_type="action_info"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/targetAv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="5000步"
                app:item_name="@string/str_target"
                app:item_type="action_info"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
