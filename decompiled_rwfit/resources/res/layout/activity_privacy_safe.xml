<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@drawable/svg_confirmdialog_ok"
        app:title_text="@string/str_privacy_safe"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/personSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_sync_person"
        app:item_type="action_switch"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/sportSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_sync_sport"
        app:item_type="action_switch"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/healthSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_sync_health"
        app:item_type="action_switch"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/clearALLAv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_clear_data"/>
</LinearLayout>
