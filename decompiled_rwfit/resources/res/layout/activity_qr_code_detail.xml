<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/qrCodeIv"
                android:layout_width="@dimen/qb_px_168"
                android:layout_height="@dimen/qb_px_168"/>
            <EditText
                android:textSize="@dimen/qb_px_18"
                android:textColor="@android:color/white"
                android:textColorHint="@color/color_cccccc"
                android:gravity="center_horizontal"
                android:id="@+id/editEt"
                android:background="@drawable/bg_item"
                android:padding="@dimen/qb_px_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_20"
                android:hint="@string/str_please_input_name"
                android:maxLength="255"/>
            <Button
                android:textColor="@android:color/white"
                android:id="@+id/changeBtn"
                android:background="@drawable/bg_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                android:text="@string/str_replace"/>
            <Button
                android:textColor="@android:color/white"
                android:id="@+id/clearBtn"
                android:background="@drawable/bg_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                android:text="@string/str_clear"/>
            <Button
                android:textColor="@android:color/white"
                android:id="@+id/saveBtn"
                android:background="@drawable/bg_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                android:text="@string/str_save"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
