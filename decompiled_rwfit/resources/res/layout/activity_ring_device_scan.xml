<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerlayout"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_hs_unbind"
        android:background="@android:color/black"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/rl_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_44">
            <ImageView
                android:id="@+id/iv_menu"
                android:layout_width="@dimen/qb_px_30"
                android:layout_height="@dimen/qb_px_30"
                android:src="@mipmap/ic_tb_menu"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/qb_px_20"/>
            <TextView
                android:textSize="@dimen/qb_px_20"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/str_ring_add_device"
                android:layout_toStartOf="@+id/iv_top_qcode"
                android:layout_toEndOf="@+id/iv_menu"/>
            <ImageView
                android:id="@+id/iv_top_qcode"
                android:layout_width="@dimen/qb_px_30"
                android:layout_height="@dimen/qb_px_30"
                android:src="@mipmap/ic_tb_qcode"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_20"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_white"
            android:id="@+id/tv_hs_unbind_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="@string/headset_scan_title"
            android:layout_below="@+id/rl_title"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/iv_hs_scan_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@mipmap/hs_scan_icon"
            android:layout_below="@+id/tv_hs_unbind_title"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/rl_radar"
            android:layout_width="@dimen/qb_px_250"
            android:layout_height="@dimen/qb_px_250"
            android:layout_below="@+id/rl_title"
            android:layout_centerHorizontal="true">
            <com.example.test.ui.view.RadarView
                android:id="@+id/radarView1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:radar_view_center_image="@mipmap/ic_radar_center"
                app:radar_view_color="#ff59a8e9"
                app:radar_view_is_alpha="true"
                app:radar_view_space="210"
                app:radar_view_speed="15"/>
            <View
                android:id="@+id/iv_search_bg"
                android:background="@mipmap/ic_radar_center"
                android:layout_width="@dimen/qb_px_180"
                android:layout_height="@dimen/qb_px_180"
                android:layout_marginTop="0dp"
                android:layout_alignParentTop="false"
                android:layout_centerInParent="true"
                android:layout_marginStart="0dp"
                android:layout_alignParentStart="false"/>
            <ImageView
                android:id="@+id/iv_search"
                android:layout_width="@dimen/qb_px_80"
                android:layout_height="@dimen/qb_px_80"
                android:src="@mipmap/ic_radar_two"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_white"
                android:gravity="center_horizontal"
                android:id="@+id/tv_search"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="@string/str_ring_retry_search"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_white"
            android:id="@+id/tv_hs_unbind_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/headset_scan_tip"
            android:layout_below="@+id/iv_hs_scan_icon"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_white"
            android:id="@+id/tv_hs_scan_title"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/headset_scan_device_tip"
            android:layout_above="@+id/tv_hs_unbind_title"
            android:layout_below="@+id/rl_radar"
            android:layout_marginStart="24dp"/>
        <ImageView
            android:id="@+id/iv_hs_refresh"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:src="@mipmap/hs_scan_reflush"
            android:layout_alignTop="@+id/tv_hs_scan_title"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@+id/tv_hs_scan_title"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/deviceList"
            android:paddingBottom="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/tv_hs_scan_title"
            android:paddingStart="@dimen/qb_px_10"
            android:paddingEnd="@dimen/qb_px_10"/>
    </RelativeLayout>
    <com.google.android.material.navigation.NavigationView
        android:layout_gravity="start"
        android:id="@+id/nav_view"
        android:background="@color/ring_leftmenu_bg"
        android:fitsSystemWindows="false"
        android:layout_width="@dimen/qb_px_240"
        android:layout_height="match_parent"
        app:headerLayout="@layout/view_leftmenu_header"
        app:itemIconPadding="@dimen/qb_px_20"
        app:itemTextColor="@color/color_white"
        app:menu="@menu/left_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>
