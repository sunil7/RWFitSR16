<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/ring_item_feedback_title"/>
    <androidx.core.widget.NestedScrollView
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_suggest"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="@android:color/holo_red_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"
                    android:layout_marginStart="@dimen/qb_px_4"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="?attr/colorOnPrimary"
                    android:gravity="end"
                    android:id="@+id/limitLenTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="0/400"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_item_theme"
                android:padding="@dimen/qb_px_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10">
                <EditText
                    android:textColor="?attr/colorOnPrimary"
                    android:textColorHint="@color/color_cccccc"
                    android:gravity="start"
                    android:id="@+id/feedbackContent"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_200"
                    android:hint="@string/str_your_question"
                    android:maxLength="400"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/imageList"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10">
                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
                <TextView
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_app_log"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_4">
                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_device_log"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_email"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="@android:color/holo_red_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"
                    android:layout_marginStart="@dimen/qb_px_4"/>
            </LinearLayout>
            <EditText
                android:textSize="@dimen/qb_px_14"
                android:textColor="?attr/colorOnPrimary"
                android:textColorHint="@color/color_cccccc"
                android:id="@+id/contactEt"
                android:background="@drawable/bg_item_theme"
                android:padding="@dimen/qb_px_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                android:hint="@string/str_email"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_orderid_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ring_str_orderid_details"/>
            </LinearLayout>
            <EditText
                android:textSize="@dimen/qb_px_14"
                android:textColor="?attr/colorOnPrimary"
                android:textColorHint="@color/color_cccccc"
                android:id="@+id/orderIdEt"
                android:background="@drawable/bg_item_theme"
                android:padding="@dimen/qb_px_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                android:hint="@string/ring_str_please_orderid_dinput_details"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ring_str_deviceModel_details"/>
            </LinearLayout>
            <TextView
                android:textColor="?attr/colorOnPrimary"
                android:textColorHint="@color/color_cccccc"
                android:id="@+id/deviceModelEt"
                android:background="@drawable/bg_item_theme"
                android:padding="@dimen/qb_px_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                android:hint="@string/ring_str_please_input_details"/>
            <Button
                android:textColor="@android:color/white"
                android:id="@+id/commit"
                android:background="@drawable/bg_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                android:text="@string/str_commit_feedback"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
