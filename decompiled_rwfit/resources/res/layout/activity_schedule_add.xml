<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@mipmap/ic_save"
        app:title_text="@string/str_schedule_add_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/scheduleTitleAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:is_show_icon="false"
            app:item_hint="@string/str_schedule_title"
            app:item_name="@string/str_title"
            app:item_type="action_info"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/scheduleTimeAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:is_show_icon="false"
            app:item_name="@string/str_time"
            app:item_type="action_info"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/scheduleRemindAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:is_show_icon="false"
            app:item_hint="@string/str_schedule_remind_now"
            app:item_name="@string/str_remind_time"
            app:item_type="action_info"/>
        <EditText
            android:textSize="@dimen/qb_px_14"
            android:textColor="@android:color/white"
            android:textColorHint="@color/color_cccccc"
            android:id="@+id/scheduleMsgEdit"
            android:background="@drawable/bg_item"
            android:paddingTop="@dimen/qb_px_15"
            android:paddingBottom="@dimen/qb_px_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            android:hint="@string/str_schedule_msg"
            android:maxLength="250"
            android:paddingStart="@dimen/qb_px_10"
            android:paddingEnd="@dimen/qb_px_10"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@android:color/white"
            android:gravity="end"
            android:id="@+id/scheduleMsgLimitTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_5"
            android:text="0/250"
            android:layout_marginStart="@dimen/qb_px_10"
            android:layout_marginEnd="@dimen/qb_px_10"/>
    </LinearLayout>
</LinearLayout>
