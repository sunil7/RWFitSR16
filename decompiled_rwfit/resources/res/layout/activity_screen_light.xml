<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@mipmap/ic_save"
        app:title_text="@string/str_screen_light"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/brightScreenAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:is_show_icon="false"
            app:item_name="@string/str_screen_light"
            app:item_type="action_switch"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/startTimeAv"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:is_show_icon="false"
            app:item_hint="00:00"
            app:item_name="@string/str_start_time"
            app:item_type="action_info"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/endTimeAv"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:is_show_icon="false"
            app:item_hint="00:00"
            app:item_name="@string/str_end_time"
            app:item_type="action_info"/>
    </LinearLayout>
</LinearLayout>
