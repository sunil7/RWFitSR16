<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="@string/str_setting"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/backgroudSafe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_backgroud_safe"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/accountSafeAv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_account_safe"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/unitAv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_hint="@string/str_unit_metric"
        app:item_name="@string/str_unit"
        app:item_type="action_info"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/tempAv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_hint="@string/str_temp_centigrade"
        app:item_name="@string/str_temp"
        app:item_type="action_info"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/privacyAv"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_name="@string/str_privacy_safe"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/cacheAv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_hint="100 KB"
        app:item_name="@string/str_clear_cache"
        app:item_type="action_info"/>
</LinearLayout>
