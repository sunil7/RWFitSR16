<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@drawable/svg_confirmdialog_ok"
        app:title_text="@string/ring_str_item_sleepmode"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/drinkAv"
            android:background="@drawable/bg_item"
            android:paddingTop="@dimen/qb_px_15"
            android:paddingBottom="@dimen/qb_px_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/qb_px_10"
            android:paddingEnd="@dimen/qb_px_10">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/itemName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ring_str_item_enable_title"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/qb_px_10"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/scBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/ring_bottomtext_sel"
                    app:trackTint="@drawable/ring_switch_track_color"/>
                <com.example.test.ui.view.PointView
                    android:id="@+id/pointView"
                    android:visibility="gone"
                    android:layout_width="@dimen/qb_px_10"
                    android:layout_height="@dimen/qb_px_10"
                    android:layout_marginStart="@dimen/qb_px_6"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/qb_px_13"
                android:textColor="?attr/colorOnPrimary"
                android:id="@+id/remarkTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ring_str_item_sleepmode_tips"
                android:layout_marginStart="@dimen/qb_px_10"/>
        </LinearLayout>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/startTimeAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:is_show_icon="false"
            app:item_hint="00:00"
            app:item_name="@string/ring_str_item_sleepmode_startime"
            app:item_type="action_info"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/endTimeAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:is_show_icon="false"
            app:item_hint="00:00"
            app:item_name="@string/ring_str_item_sleepmode_endtime"
            app:item_type="action_info"/>
    </LinearLayout>
</LinearLayout>
