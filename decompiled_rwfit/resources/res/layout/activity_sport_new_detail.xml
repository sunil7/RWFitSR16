<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:padding="@dimen/qb_px_10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.ToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_title="@string/str_tab_sport_running"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/data"
        android:background="@drawable/bg_ring_item"
        android:paddingTop="@dimen/qb_px_54"
        android:paddingBottom="@dimen/dp_40"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <TextView
            android:textSize="@dimen/qb_px_32"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"
            android:id="@+id/distanceTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/qb_px_18"
            android:textColor="?attr/colorOnPrimary"
            android:id="@+id/distanceUnitTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/qb_px_4"
            android:text="@string/str_km"
            android:layout_marginStart="@dimen/qb_px_8"
            app:layout_constraintBottom_toBottomOf="@+id/distanceTv"
            app:layout_constraintLeft_toRightOf="@+id/distanceTv"/>
        <LinearLayout
            android:id="@+id/ll_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_52"
            app:layout_constraintTop_toBottomOf="@+id/distanceTv">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_kcal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/ll_time"
                app:layout_constraintTop_toBottomOf="@+id/distanceTv">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_cal"/>
                <TextView
                    android:textSize="@dimen/qb_px_24"
                    android:textColor="?attr/colorOnPrimary"
                    android:ellipsize="end"
                    android:id="@+id/caloriesTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_6"
                    android:text="0.0"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_6"
                    android:text="@string/str_cal"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintLeft_toRightOf="@+id/ll_time"
                app:layout_constraintRight_toLeftOf="@+id/ll_pics"
                app:layout_constraintTop_toBottomOf="@+id/distanceTv">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_time"/>
                <TextView
                    android:textSize="@dimen/qb_px_24"
                    android:textColor="?attr/colorOnPrimary"
                    android:ellipsize="end"
                    android:id="@+id/totalTimeTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_6"
                    android:text="00:00:00"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_6"
                    android:text="@string/str_time"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_pics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintLeft_toRightOf="@+id/ll_time"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/distanceTv">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_hr_check"/>
                <TextView
                    android:textSize="@dimen/qb_px_24"
                    android:textColor="?attr/colorOnPrimary"
                    android:ellipsize="end"
                    android:id="@+id/currentPaceTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_6"
                    android:text="--"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_6"
                    android:text="@string/str_hr_title"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_ring_item"
        android:paddingTop="@dimen/dp_40"
        android:paddingBottom="@dimen/dp_40"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/pauseBtn"
                android:padding="@dimen/qb_px_20"
                android:layout_width="@dimen/qb_px_140"
                android:layout_height="@dimen/qb_px_140"
                android:src="@mipmap/ic_sport_pause"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <com.example.test.ui.view.LongClickView
                android:id="@+id/progressView"
                android:visibility="gone"
                android:layout_width="@dimen/qb_px_100"
                android:layout_height="@dimen/qb_px_100"
                app:annulusColor="@android:color/white"
                app:annulusWidth="15"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:maxSeconds="2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:id="@+id/sportPauseLl"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="@dimen/qb_px_140"
                android:layout_height="@dimen/qb_px_140"
                app:layout_constraintTop_toBottomOf="@+id/ll_time">
                <ImageView
                    android:id="@+id/stopBtn"
                    android:padding="@dimen/qb_px_20"
                    android:layout_width="@dimen/qb_px_140"
                    android:layout_height="@dimen/qb_px_140"
                    android:src="@mipmap/ic_sport_finish"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>
                <com.example.test.ui.view.LongClickView
                    android:id="@+id/progressViewCancel"
                    android:layout_width="@dimen/qb_px_100"
                    android:layout_height="@dimen/qb_px_100"
                    app:annulusColor="@android:color/white"
                    app:annulusWidth="15"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:maxSeconds="2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/playBtn"
                android:padding="@dimen/qb_px_20"
                android:layout_width="@dimen/qb_px_140"
                android:layout_height="@dimen/qb_px_140"
                android:src="@mipmap/ic_sport_start"
                android:layout_marginStart="@dimen/qb_px_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_time"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llTips"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="?attr/colorOnPrimary"
                android:gravity="center"
                android:id="@+id/cancelTips"
                android:layout_width="@dimen/qb_px_140"
                android:layout_height="wrap_content"
                android:text="@string/str_longpress_end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="?attr/colorOnPrimary"
                android:gravity="center"
                android:id="@+id/continueTips"
                android:layout_width="@dimen/qb_px_140"
                android:layout_height="wrap_content"
                android:text="@string/str_click_continue"
                android:layout_marginStart="@dimen/qb_px_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/qb_px_12"
            android:textColor="?attr/colorOnPrimary"
            android:id="@+id/longTips"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_longpress_unlock"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/ivLock"
        android:layout_width="@dimen/qb_px_42"
        android:layout_height="@dimen/qb_px_42"
        android:layout_marginBottom="@dimen/qb_px_10"
        android:src="@mipmap/ic_lock"
        android:layout_marginStart="@dimen/qb_px_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <ImageView
        android:id="@+id/tvMap"
        android:layout_width="@dimen/qb_px_42"
        android:layout_height="@dimen/qb_px_42"
        android:layout_marginBottom="@dimen/qb_px_10"
        android:src="@mipmap/ic_map"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
