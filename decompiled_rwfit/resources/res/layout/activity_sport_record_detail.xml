<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_back="@mipmap/ic_back_blue"
        app:title_right="@mipmap/ic_share"
        app:title_text="@string/str_sport_detail"
        app:title_text_color="@android:color/black"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.example.test.ui.view.MapContainer
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.amap.api.maps.MapView
                    android:id="@+id/mapView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_430"/>
                <ImageView
                    android:id="@+id/sportIv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/bg_sport_indoor"
                    android:scaleType="fitXY"/>
            </com.example.test.ui.view.MapContainer>
            <LinearLayout
                android:orientation="vertical"
                android:background="?attr/colorPrimary"
                android:paddingLeft="@dimen/qb_px_16"
                android:paddingTop="@dimen/qb_px_16"
                android:paddingRight="@dimen/qb_px_16"
                android:paddingBottom="@dimen/qb_px_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/distance_step_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/qb_px_16"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_total_time"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:id="@+id/totalTimeTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/qb_px_10"
                            android:text="00:00:00"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/qb_px_16"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_cost_cal"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:id="@+id/caloriesTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/qb_px_10"
                            android:text="0.00 千卡"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/distance_layout"
                        android:padding="@dimen/qb_px_16"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_distance"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:id="@+id/distanceTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/qb_px_10"
                            android:text="0.00 公里"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/step_count_layout"
                        android:padding="@dimen/qb_px_16"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_step"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:id="@+id/stepsTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/qb_px_10"
                            android:text="0"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/pace_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:layout_width="match_parent"
                        style="@style/style_horizontal_line_light"/>
                    <TextView
                        android:textSize="@dimen/qb_px_14"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_10"
                        android:text="@string/str_pace"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_6">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_avg_pace"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@android:color/white"
                            android:id="@+id/avgPace"
                            android:background="@drawable/bg_shape_yellow"
                            android:padding="@dimen/qb_px_6"
                            android:layout_width="@dimen/qb_px_200"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="0&apos;00&apos;&apos;"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_6">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/str_max_pice"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@android:color/white"
                            android:id="@+id/maxPace"
                            android:background="@drawable/bg_shape_red"
                            android:padding="@dimen/qb_px_6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="0&apos;00&apos;&apos;"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_6">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/str_min_pace"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@android:color/white"
                            android:id="@+id/minPace"
                            android:background="@drawable/bg_shape_green"
                            android:padding="@dimen/qb_px_6"
                            android:layout_width="@dimen/qb_px_150"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="0&apos;00&apos;&apos;"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/step_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/qb_px_10"
                        style="@style/style_horizontal_line_light"/>
                    <TextView
                        android:textSize="@dimen/qb_px_14"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_10"
                        android:text="@string/str_step_pace"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_6">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_avg_step_pace"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@android:color/white"
                            android:id="@+id/avgStep"
                            android:background="@drawable/bg_shape_yellow"
                            android:padding="@dimen/qb_px_6"
                            android:layout_width="@dimen/qb_px_200"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="563 步/分钟"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_6">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/str_max_step_pace"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@android:color/white"
                            android:id="@+id/maxStep"
                            android:background="@drawable/bg_shape_red"
                            android:padding="@dimen/qb_px_6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="1035 步/分钟"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_6">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/str_min_step_pace"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@android:color/white"
                            android:id="@+id/minStep"
                            android:background="@drawable/bg_shape_green"
                            android:padding="@dimen/qb_px_6"
                            android:layout_width="@dimen/qb_px_150"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="203 步/分钟"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/hr_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/qb_px_10"
                        style="@style/style_horizontal_line_light"/>
                    <TextView
                        android:textSize="@dimen/qb_px_14"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_10"
                        android:text="@string/str_hr_title"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_6">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_avg_hr"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@android:color/white"
                            android:id="@+id/avgHr"
                            android:background="@drawable/bg_shape_yellow"
                            android:padding="@dimen/qb_px_6"
                            android:layout_width="@dimen/qb_px_200"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="563 步/分钟"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_6">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/str_max_hr"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@android:color/white"
                            android:id="@+id/maxHr"
                            android:background="@drawable/bg_shape_red"
                            android:padding="@dimen/qb_px_6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="1035 步/分钟"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_6">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/str_min_hr"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@android:color/white"
                            android:id="@+id/minHr"
                            android:background="@drawable/bg_shape_green"
                            android:padding="@dimen/qb_px_6"
                            android:layout_width="@dimen/qb_px_150"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="203 步/分钟"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/hrLl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/qb_px_10"
                        style="@style/style_horizontal_line_light"/>
                    <TextView
                        android:textSize="@dimen/qb_px_14"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_10"
                        android:text="@string/str_hr_title"/>
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/hrChart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/qb_px_160"
                        android:layout_marginTop="@dimen/qb_px_10"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
