<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.testui.TRingToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_status_res="@drawable/svg_ic_tb_back"
        app:bar_title=""
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/rl_indoorrun"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_50">
        <ImageView
            android:id="@+id/iv_indoorrun"
            android:layout_width="@dimen/qb_px_30"
            android:layout_height="@dimen/qb_px_30"
            android:src="@mipmap/ic_st_outdoorrunl"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_tab_sport_running_indoor"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"
            android:layout_toEndOf="@+id/iv_indoorrun"/>
        <ImageView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:src="@mipmap/ring_more_arrow"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/qb_px_20"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/ring_activitypage_text_mask"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_1"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/qb_px_10"
            android:layout_marginEnd="@dimen/qb_px_10"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_outdoorrun"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_50">
        <ImageView
            android:id="@+id/iv_outdoorrun"
            android:layout_width="@dimen/qb_px_30"
            android:layout_height="@dimen/qb_px_30"
            android:src="@mipmap/ic_st_indoorrun"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_tab_sport_running_outdoor"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"
            android:layout_toEndOf="@+id/iv_outdoorrun"/>
        <ImageView
            android:layout_width="@dimen/qb_px_20"
            android:layout_height="@dimen/qb_px_20"
            android:src="@mipmap/ring_more_arrow"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/qb_px_20"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/ring_activitypage_text_mask"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_1"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/qb_px_10"
            android:layout_marginEnd="@dimen/qb_px_10"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_healthwalk"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_50">
        <ImageView
            android:id="@+id/iv_healthwalk"
            android:layout_width="@dimen/qb_px_30"
            android:layout_height="@dimen/qb_px_30"
            android:src="@mipmap/ic_st_healthywalk"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_tab_sport_walking"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"
            android:layout_toEndOf="@+id/iv_healthwalk"/>
        <ImageView
            android:layout_width="@dimen/qb_px_20"
            android:layout_height="@dimen/qb_px_20"
            android:src="@mipmap/ring_more_arrow"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/qb_px_20"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/ring_activitypage_text_mask"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_1"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/qb_px_10"
            android:layout_marginEnd="@dimen/qb_px_10"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_ridebike"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_50">
        <ImageView
            android:id="@+id/iv_ridebike"
            android:layout_width="@dimen/qb_px_30"
            android:layout_height="@dimen/qb_px_30"
            android:src="@mipmap/ic_st_ridebike"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_tab_sport_biking"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"
            android:layout_toEndOf="@+id/iv_ridebike"/>
        <ImageView
            android:layout_width="@dimen/qb_px_20"
            android:layout_height="@dimen/qb_px_20"
            android:src="@mipmap/ring_more_arrow"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/qb_px_20"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/ring_activitypage_text_mask"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_1"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/qb_px_10"
            android:layout_marginEnd="@dimen/qb_px_10"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_climbmoun"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_50">
        <ImageView
            android:id="@+id/iv_climbmoun"
            android:layout_width="@dimen/qb_px_30"
            android:layout_height="@dimen/qb_px_30"
            android:src="@mipmap/ic_st_climbmountains"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_tab_sport_climing"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"
            android:layout_toEndOf="@+id/iv_climbmoun"/>
        <ImageView
            android:layout_width="@dimen/qb_px_20"
            android:layout_height="@dimen/qb_px_20"
            android:src="@mipmap/ring_more_arrow"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/qb_px_20"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="@color/ring_activitypage_text_mask"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_1"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/qb_px_10"
            android:layout_marginEnd="@dimen/qb_px_10"/>
    </RelativeLayout>
</LinearLayout>
