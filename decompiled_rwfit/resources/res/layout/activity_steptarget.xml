<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.testui.TRingToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_status_res="@drawable/svg_ic_tb_back"
        app:bar_title="@string/str_target_setting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_20"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/steptargetAv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="5000步"
                app:item_name="@string/str_step"
                app:item_type="action_info"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/calutargetAv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="300千卡"
                app:item_name="@string/str_cal"
                app:item_type="action_info"/>
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/disttargetAv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/qb_px_10"
                app:is_show_icon="false"
                app:item_hint="3.0公里"
                app:item_name="@string/str_distance_goal"
                app:item_type="action_info"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_200"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
