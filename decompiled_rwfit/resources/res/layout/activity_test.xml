<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/testTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_text="测试"/>
    <androidx.core.widget.NestedScrollView
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/testStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="插入步数数据"/>
            <Button
                android:id="@+id/testSleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="插入睡眠数据"/>
            <Button
                android:id="@+id/testHr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="插入心率数据"/>
            <Button
                android:id="@+id/testTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="插入体温数据"/>
            <Button
                android:id="@+id/testBo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="插入血氧数据"/>
            <Button
                android:id="@+id/testBp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="插入血压数据"/>
            <Button
                android:id="@+id/testBreathe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="插入呼吸数据"/>
            <Button
                android:id="@+id/receiveData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模拟接收数据"/>
            <Button
                android:id="@+id/sendSingleData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模拟发送单包数据"/>
            <Button
                android:id="@+id/sendData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模拟发送数据"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textColor="@android:color/white"
        android:id="@+id/testResult"
        android:scrollbars="vertical"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/qb_px_100"
        android:text="result --&gt; "/>
</LinearLayout>
