<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.testui.TRingToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_status_res="@drawable/svg_ic_tb_back"
        app:bar_title="@string/ring_item_theme_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/theme_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:text="@string/ring_item_theme_bg_title"
        android:layout_marginStart="@dimen/qb_px_10"/>
    <RelativeLayout
        android:id="@+id/rl_theme_black"
        android:background="@mipmap/theme_black_nor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_80"
        android:layout_marginTop="@dimen/qb_px_20"
        android:layoutDirection="ltr"
        android:layout_marginStart="@dimen/qb_px_20"
        android:layout_marginEnd="@dimen/qb_px_20">
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@color/color_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ring_item_theme_black"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_theme_white"
        android:background="@mipmap/theme_white_nor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_80"
        android:layout_marginTop="@dimen/qb_px_20"
        android:layoutDirection="ltr"
        android:layout_marginStart="@dimen/qb_px_20"
        android:layout_marginEnd="@dimen/qb_px_20">
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@color/colorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ring_item_theme_white"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_theme_pink"
        android:background="@mipmap/theme_pink_nor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_80"
        android:layout_marginTop="@dimen/qb_px_20"
        android:layoutDirection="ltr"
        android:layout_marginStart="@dimen/qb_px_20"
        android:layout_marginEnd="@dimen/qb_px_20">
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@color/colorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ring_item_theme_pink"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"/>
    </RelativeLayout>
</LinearLayout>
