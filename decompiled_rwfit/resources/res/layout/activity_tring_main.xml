<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/contentViewMain"
        layout="@layout/view_main"/>
    <com.google.android.material.navigation.NavigationView
        android:layout_gravity="start"
        android:id="@+id/nav_view"
        android:background="?attr/colorPrimary"
        android:layout_width="@dimen/qb_px_240"
        android:layout_height="match_parent"
        app:headerLayout="@layout/view_leftmenu_header"
        app:itemIconPadding="@dimen/qb_px_20"
        app:itemTextColor="?attr/colorOnPrimary"
        app:menu="@menu/left_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>
