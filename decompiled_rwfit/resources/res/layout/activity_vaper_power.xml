<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@mipmap/ic_save"
        app:title_text="@string/str_vaperpower_title"/>
    <com.example.test.ui.view.ActionItemView
        android:id="@+id/avScreenInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:paddingStart="@dimen/qb_px_10"
        android:paddingEnd="@dimen/qb_px_10"
        app:is_show_icon="false"
        app:item_hint="@string/str_vaperpower_mode_normal"
        app:item_name="@string/str_vaperpower_title"
        app:item_type="action_info"/>
</LinearLayout>
