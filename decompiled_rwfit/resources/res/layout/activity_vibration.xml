<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@drawable/svg_confirmdialog_ok"
        app:title_text="@string/ring_str_item_vibration"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_health_heart"
            android:background="@drawable/bg_ring_item"
            android:paddingTop="@dimen/qb_px_10"
            android:paddingBottom="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textColor="?attr/colorOnPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ring_str_item_vibrationlevel"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_toStartOf="@+id/tv_health_hr_value"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/ivNext"
                android:layout_width="@dimen/qb_px_9"
                android:layout_height="@dimen/qb_px_16"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_15"
                android:layout_alignParentEnd="true"
                app:srcCompat="@mipmap/ic_arrow_right"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_828282"
                android:id="@+id/tv_health_hr_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_ring_screen_light_0"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_5"
                android:layout_toStartOf="@+id/ivNext"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_health_heart2"
            android:background="@drawable/bg_ring_item"
            android:paddingTop="@dimen/qb_px_10"
            android:paddingBottom="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10">
            <TextView
                android:textSize="18sp"
                android:textColor="?attr/colorOnPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ring_str_item_vibrationcount_alarm"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_toStartOf="@+id/tv_health_hr_value2"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/ivNext2"
                android:layout_width="@dimen/qb_px_9"
                android:layout_height="@dimen/qb_px_16"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_15"
                android:layout_alignParentEnd="true"
                app:srcCompat="@mipmap/ic_arrow_right"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_828282"
                android:id="@+id/tv_health_hr_value2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_ring_screen_light_0"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_5"
                android:layout_toStartOf="@+id/ivNext2"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
