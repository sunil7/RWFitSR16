<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@mipmap/ic_save"
        app:title_text="@string/str_ring_video_control"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/videoHidOpenAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:is_show_icon="false"
            app:item_name="@string/str_ring_video_control_open"
            app:item_type="action_switch"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/videoHidOpenDefaultAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:is_show_icon="false"
            app:item_name="@string/str_ring_video_control_open_default"
            app:item_type="action_switch"/>
    </LinearLayout>
</LinearLayout>
