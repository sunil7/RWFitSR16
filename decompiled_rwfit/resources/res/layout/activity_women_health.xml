<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.view.TitleView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_right="@mipmap/ic_save"
        app:title_text="@string/str_menstrual_cycle_reminder"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never">
            <com.example.test.ui.view.ActionItemView
                android:id="@+id/av_wh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:is_show_icon="false"
                app:item_name="@string/str_menstrual_cycle_reminder"
                app:item_type="action_switch"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_action"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.example.test.ui.view.ActionItemView
                    android:id="@+id/mens_remind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    app:is_show_icon="false"
                    app:item_hint="28"
                    app:item_name="@string/str_remind_menstrual_period"
                    app:item_type="action_info"/>
                <com.example.test.ui.view.ActionItemView
                    android:id="@+id/ovulation_remind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    app:is_show_icon="false"
                    app:item_hint="5"
                    app:item_name="@string/str_remind_ovulation_period"
                    app:item_type="action_info"/>
                <com.example.test.ui.view.ActionItemView
                    android:id="@+id/range_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    app:is_show_icon="false"
                    app:item_hint="28"
                    app:item_name="@string/str_cycle_days"
                    app:item_type="action_info"/>
                <com.example.test.ui.view.ActionItemView
                    android:id="@+id/menstrual_period"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    app:is_show_icon="false"
                    app:item_hint="5"
                    app:item_name="@string/str_menstrual_days"
                    app:item_type="action_info"/>
                <com.example.test.ui.view.ActionItemView
                    android:id="@+id/last_mens_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    app:is_show_icon="false"
                    app:item_hint="2022/11/05"
                    app:item_name="@string/str_menstrual_last_time"
                    app:item_type="action_info"/>
                <com.example.test.ui.view.ActionItemView
                    android:id="@+id/remind_model"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    app:is_show_icon="false"
                    app:item_name="@string/str_warn_model"
                    app:item_type="action_next"/>
                <com.example.test.ui.view.ActionItemView
                    android:id="@+id/remind_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    app:is_show_icon="false"
                    app:item_hint="09:00"
                    app:item_name="@string/str_remind_time"
                    app:item_type="action_info"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
