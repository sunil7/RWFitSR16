<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linear_bg"
        android:background="@drawable/bg_bottom_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            android:layout_marginStart="@dimen/qb_px_32"
            android:layout_marginEnd="@dimen/qb_px_32">
            <TextView
                android:textSize="@dimen/qb_px_18"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/dialog_cancel"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="@dimen/qb_px_10"
                android:paddingBottom="@dimen/qb_px_10"
                android:visibility="visible"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/str_cancel"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/qb_px_18"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="end"
                android:id="@+id/dialog_submit"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="@dimen/qb_px_10"
                android:paddingBottom="@dimen/qb_px_10"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/str_sure"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextBlack"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorTextBlack"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_choose_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text=""/>
        <View
            android:id="@+id/divider_top"
            android:background="#e5e5e5"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"/>
        <com.loper7.date_time_picker.DateTimePicker
            android:id="@+id/dateTimePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/qb_px_15"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/linear_now"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorTextGrayDark"
                android:id="@+id/tv_go_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="120dp"
                android:text="回到今天"/>
            <TextView
                android:textSize="26dp"
                android:textColor="@color/colorTextWhite"
                android:gravity="center"
                android:id="@+id/btn_today"
                android:background="@drawable/shape_bg_oval_accent"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="30dp"
                android:text="今"
                android:elevation="2dp"/>
        </LinearLayout>
        <View
            android:id="@+id/divider_bottom"
            android:background="#e5e5e5"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</LinearLayout>
