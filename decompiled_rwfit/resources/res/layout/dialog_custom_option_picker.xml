<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linear_bg"
        android:background="@drawable/bg_bottom_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            android:layout_marginStart="@dimen/qb_px_32"
            android:layout_marginEnd="@dimen/qb_px_32">
            <TextView
                android:textSize="@dimen/qb_px_18"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/dialog_cancel"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="@dimen/qb_px_10"
                android:paddingBottom="@dimen/qb_px_10"
                android:visibility="visible"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/str_cancel"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/qb_px_18"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="end"
                android:id="@+id/dialog_submit"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="@dimen/qb_px_10"
                android:paddingBottom="@dimen/qb_px_10"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/str_sure"
                android:layout_weight="1"/>
        </LinearLayout>
        <com.loper7.date_time_picker.number_picker.NumberPicker
            android:id="@+id/content_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/qb_px_15"
            android:layout_marginStart="@dimen/qb_px_15"
            android:layout_marginEnd="@dimen/qb_px_15"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/np_datetime_hour"
            app:layout_constraintTop_toTopOf="parent"
            app:np_dividerColor="#e5e5e5"
            app:np_dividerThickness="0.6dp"
            app:np_height="184dp"
            app:np_selectedTextColor="@color/color_17fff1"
            app:np_selectedTextSize="17sp"
            app:np_textColor="@color/colorTextGray"
            app:np_textSize="14sp"
            app:np_wheelItemCount="3"/>
    </LinearLayout>
</LinearLayout>
