<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_dialog_theme"
    android:padding="@dimen/qb_px_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textColor="?attr/colorOnPrimary"
        android:gravity="center"
        android:id="@+id/tvCancel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/qb_px_44"
        android:text="@string/str_cancel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tvSure"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textColor="?attr/colorOnPrimary"
        android:gravity="center"
        android:id="@+id/tvSure"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/qb_px_44"
        android:text="@string/str_sure"
        app:layout_constraintLeft_toRightOf="@+id/tvCancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.haibin.calendarview.CalendarView
        android:id="@+id/calendarView"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:calendar_height="44dp"
        app:calendar_padding="5dp"
        app:current_day_text_color="?attr/colorSecondary"
        app:current_month_text_color="?attr/colorOnPrimary"
        app:day_text_size="14sp"
        app:layout_constraintTop_toBottomOf="@+id/tvSure"
        app:min_year="2004"
        app:month_view="com.example.test.ui.view.calendar.SimpleMonthView"
        app:month_view_show_mode="mode_fix"
        app:other_month_text_color="@color/color_828282"
        app:scheme_month_text_color="#ff30cc"
        app:scheme_text_color="@color/color_3cfff"
        app:selected_text_color="@android:color/white"
        app:selected_theme_color="@android:color/holo_blue_light"
        app:week_background="@null"
        app:week_bar_height="@dimen/qb_px_24"
        app:week_bar_view="com.example.test.ui.view.calendar.CustomWeekBar"
        app:week_line_margin="1dp"
        app:week_text_color="?attr/colorOnPrimary"
        app:week_text_size="12sp"
        app:week_view="com.example.test.ui.view.calendar.SimpleWeekView"
        app:year_view_week_height="@dimen/qb_px_28"/>
</androidx.constraintlayout.widget.ConstraintLayout>
