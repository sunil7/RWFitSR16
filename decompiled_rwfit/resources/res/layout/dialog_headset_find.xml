<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_bottom_dialog"
    android:padding="@dimen/qb_px_10"
    android:layout_width="match_parent"
    android:layout_height="300dp">
    <ImageView
        android:id="@+id/ib_hs_find_left"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="15dp"
        android:src="@mipmap/headset_find_pause"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="80dp"/>
    <ImageView
        android:id="@+id/ib_hs_find_right"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="15dp"
        android:src="@mipmap/headset_find_pause"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="80dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/iv_hs_find_left_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:src="@mipmap/headset_find_left_text"
        android:layout_above="@+id/ib_hs_find_left"
        android:layout_alignStart="@+id/ib_hs_find_left"
        android:layout_alignEnd="@+id/ib_hs_find_left"/>
    <ImageView
        android:id="@+id/iv_hs_find_right_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:src="@mipmap/headset_find_right_text"
        android:layout_above="@+id/ib_hs_find_right"
        android:layout_alignStart="@+id/ib_hs_find_right"
        android:layout_alignEnd="@+id/ib_hs_find_right"/>
    <ImageView
        android:id="@+id/iv_hs_find_left_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:src="@mipmap/headset_find_left"
        android:layout_above="@+id/iv_hs_find_left_text"
        android:layout_marginStart="76dp"/>
    <ImageView
        android:id="@+id/iv_hs_find_right_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:src="@mipmap/headset_find_right"
        android:layout_above="@+id/iv_hs_find_right_text"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="76dp"/>
    <ImageView
        android:id="@+id/iv_find_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@mipmap/headset_pop_close"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ff2f24"
        android:id="@+id/tv_find_tip_text"
        android:layout_width="@dimen/qb_px_250"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/headset_find_tip"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
