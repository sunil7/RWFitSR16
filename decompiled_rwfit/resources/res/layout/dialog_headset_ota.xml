<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_bottom_dialog"
    android:padding="@dimen/qb_px_10"
    android:layout_width="match_parent"
    android:layout_height="300dp">
    <ImageView
        android:id="@+id/iv_find_close"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="@mipmap/headset_pop_close"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textColor="@color/color_e6e6e6"
        android:id="@+id/tv_hs_ota_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:text="当前版本: V0.0.1"/>
    <TextView
        android:textColor="@color/color_e6e6e6"
        android:id="@+id/tv_hs_ota_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:text="新版本: V0.1.7"
        android:layout_below="@+id/tv_hs_ota_current"/>
    <TextView
        android:textColor="@color/color_d42725"
        android:id="@+id/tv_hs_ota_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:text="固件更新过程中，请勿离开本页面，请勿操作手机和充电仓，确保更新完成！"
        android:layout_below="@+id/tv_hs_ota_new"/>
    <com.example.test.ui.view.ProgressButtonView
        android:id="@+id/progressBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_50"
        android:layout_margin="@dimen/qb_px_10"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true"
        app:button_text_size="@dimen/qb_px_16"/>
</RelativeLayout>
