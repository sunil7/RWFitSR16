<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_bottom_dialog"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_240">
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textColor="?attr/colorOnPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvCancel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/qb_px_44"
        android:text="@string/str_cancel"
        android:layout_marginStart="@dimen/qb_px_32"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textColor="?attr/colorOnPrimary"
        android:gravity="end|center_vertical"
        android:id="@+id/tvSure"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/qb_px_44"
        android:text="@string/str_sure"
        android:layout_marginEnd="@dimen/qb_px_32"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/decor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSure"/>
</androidx.constraintlayout.widget.ConstraintLayout>
