<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_unit_bg"
    android:background="@drawable/shape_background_theme_black"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_250">
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textColor="@color/color_white"
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/qb_px_44"
        android:layout_marginTop="@dimen/qb_px_10"
        android:text="@string/ring_item_unit_title"
        android:layout_marginStart="@dimen/qb_px_20"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textColor="@color/ring_bottomtext_sel"
        android:gravity="center_vertical"
        android:id="@+id/tvCancel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/qb_px_44"
        android:layout_marginBottom="@dimen/qb_px_10"
        android:text="@string/str_ring_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/decor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <RelativeLayout
            android:id="@+id/btn_lefthand"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_50">
            <TextView
                android:textSize="@dimen/qb_px_18"
                android:textColor="@color/color_white"
                android:gravity="center_vertical"
                android:id="@+id/tvlefthand"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qb_px_44"
                android:text="@string/str_unit_metric"
                android:layout_marginStart="@dimen/qb_px_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <ImageView
                android:id="@+id/iv_lefthand"
                android:layout_width="@dimen/qb_px_20"
                android:layout_height="@dimen/qb_px_20"
                android:src="@drawable/svg_select_no"
                android:layout_alignParentBottom="false"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_20"
                android:layout_alignParentEnd="true"/>
            <View
                android:background="@color/ring_activitypage_text_mask"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_1"
                android:layout_marginLeft="@dimen/qb_px_20"
                android:layout_marginRight="@dimen/qb_px_20"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/btn_righthand"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_50">
            <TextView
                android:textSize="@dimen/qb_px_18"
                android:textColor="@color/color_white"
                android:gravity="center_vertical"
                android:id="@+id/tvright"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qb_px_44"
                android:text="@string/str_unit_imperial"
                android:layout_marginStart="@dimen/qb_px_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <ImageView
                android:id="@+id/iv_righthand"
                android:layout_width="@dimen/qb_px_20"
                android:layout_height="@dimen/qb_px_20"
                android:src="@drawable/svg_select_no"
                android:layout_alignParentBottom="false"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_20"
                android:layout_alignParentEnd="true"/>
            <View
                android:background="@color/ring_activitypage_text_mask"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_1"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_marginEnd="@dimen/qb_px_20"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
