<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_videohid_bg"
    android:background="@drawable/shape_background_theme_black"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_350">
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textColor="@color/color_white"
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/qb_px_44"
        android:layout_marginTop="@dimen/qb_px_10"
        android:text="@string/ring_item_hid_title"
        android:layout_marginStart="@dimen/qb_px_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@color/ring_activitypage_red"
        android:gravity="center_vertical"
        android:id="@+id/tvSubTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:text="@string/ring_hidcontrol_tips"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textColor="@color/ring_bottomtext_sel"
        android:gravity="center_vertical"
        android:id="@+id/tvCancel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/qb_px_44"
        android:layout_marginBottom="@dimen/qb_px_10"
        android:text="@string/str_ring_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/decor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubTitle">
        <RelativeLayout
            android:id="@+id/btn_stronglight"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_50">
            <TextView
                android:textSize="@dimen/qb_px_18"
                android:textColor="@color/color_white"
                android:gravity="center_vertical"
                android:id="@+id/tvStrong"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qb_px_44"
                android:text="@string/ring_item_hid_setting_vedio"
                android:layout_marginStart="@dimen/qb_px_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/iv_stronglight"
                android:layout_width="@dimen/qb_px_20"
                android:layout_height="@dimen/qb_px_20"
                android:src="@drawable/svg_select_no"
                android:layout_alignParentBottom="false"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_20"
                android:layout_alignParentEnd="true"/>
            <View
                android:background="@color/ring_activitypage_text_mask"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_1"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_marginEnd="@dimen/qb_px_20"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/btn_softlight"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_50">
            <TextView
                android:textSize="@dimen/qb_px_18"
                android:textColor="@color/color_white"
                android:gravity="center_vertical"
                android:id="@+id/tvsoft"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qb_px_44"
                android:text="@string/ring_item_hid_setting_book"
                android:layout_marginStart="@dimen/qb_px_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/iv_softlight"
                android:layout_width="@dimen/qb_px_20"
                android:layout_height="@dimen/qb_px_20"
                android:src="@drawable/svg_select_no"
                android:layout_alignParentBottom="false"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_20"
                android:layout_alignParentEnd="true"/>
            <View
                android:background="@color/ring_activitypage_text_mask"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_1"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_marginEnd="@dimen/qb_px_20"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/btn_minlight"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_50">
            <TextView
                android:textSize="@dimen/qb_px_18"
                android:textColor="@color/color_white"
                android:gravity="center_vertical"
                android:id="@+id/tvmin"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qb_px_44"
                android:text="@string/ring_item_hid_setting_music"
                android:layout_marginStart="@dimen/qb_px_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/iv_minlight"
                android:layout_width="@dimen/qb_px_20"
                android:layout_height="@dimen/qb_px_20"
                android:src="@drawable/svg_select_no"
                android:layout_alignParentBottom="false"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_20"
                android:layout_alignParentEnd="true"/>
            <View
                android:background="@color/ring_activitypage_text_mask"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_1"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_marginEnd="@dimen/qb_px_20"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/btn_close"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_50">
            <TextView
                android:textSize="@dimen/qb_px_18"
                android:textColor="@color/color_white"
                android:gravity="center_vertical"
                android:id="@+id/tvclose"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qb_px_44"
                android:text="@string/str_ring_screen_light_0"
                android:layout_marginStart="@dimen/qb_px_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/iv_closelight"
                android:layout_width="@dimen/qb_px_20"
                android:layout_height="@dimen/qb_px_20"
                android:src="@drawable/svg_select_no"
                android:layout_alignParentBottom="false"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/qb_px_20"
                android:layout_alignParentEnd="true"/>
            <View
                android:background="@color/ring_activitypage_text_mask"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_1"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/qb_px_20"
                android:layout_marginEnd="@dimen/qb_px_20"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
