<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_item"
    android:layout_width="@dimen/qb_px_300"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tvPermissionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_16"
        android:text="@string/str_permission_title_photo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:id="@+id/tvPermissionContent"
        android:padding="@dimen/qb_px_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_permission_content_photo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPermissionTitle"/>
    <View
        android:id="@+id/line"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPermissionContent"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="@color/color_cccccc"
        android:gravity="center"
        android:id="@+id/tvPermCancel"
        android:paddingTop="@dimen/qb_px_10"
        android:paddingBottom="@dimen/qb_px_10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/str_refuse"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/line_v"/>
    <View
        android:id="@+id/line_v"
        android:background="@android:color/darker_gray"
        android:layout_width="0.5dp"
        android:layout_height="@dimen/qb_px_42"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="@color/colorAccent"
        android:gravity="center"
        android:id="@+id/tvPermSure"
        android:paddingTop="@dimen/qb_px_10"
        android:paddingBottom="@dimen/qb_px_10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/str_sure"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/line_v"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
