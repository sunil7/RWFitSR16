<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_item_theme"
    android:layout_width="@dimen/qb_px_240"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="@android:color/holo_red_light"
        android:gravity="center"
        android:id="@+id/tvCancel"
        android:paddingTop="@dimen/qb_px_10"
        android:paddingBottom="@dimen/qb_px_10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/str_cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/line_v"/>
    <View
        android:id="@+id/line_v"
        android:background="@android:color/darker_gray"
        android:layout_width="0.5dp"
        android:layout_height="@dimen/qb_px_42"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="@android:color/holo_red_dark"
        android:gravity="center"
        android:id="@+id/tvSure"
        android:paddingTop="@dimen/qb_px_10"
        android:paddingBottom="@dimen/qb_px_10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/str_sure"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/line_v"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="@android:color/holo_red_dark"
        android:gravity="center"
        android:id="@+id/tvSureSingle"
        android:paddingTop="@dimen/qb_px_10"
        android:paddingBottom="@dimen/qb_px_10"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/str_sure"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:id="@+id/line_h"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toTopOf="@+id/line_v"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="?attr/colorOnPrimary"
        android:gravity="center"
        android:id="@+id/tvTips"
        android:padding="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/str_sport_permisson_tips"
        app:layout_constraintBottom_toBottomOf="@+id/line_h"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
