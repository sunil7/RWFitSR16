<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_item"
    android:layout_width="@dimen/qb_px_300"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@android:color/white"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_16"
        android:text="@string/str_welcome_use"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:id="@+id/tvProContent"
        android:padding="@dimen/qb_px_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_user_protocol_tips"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:id="@+id/tvReadProtocol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请查阅《用户协议》、《隐私协议》"
        android:paddingStart="@dimen/qb_px_16"
        android:paddingEnd="@dimen/qb_px_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProContent"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:id="@+id/tvTips"
        android:padding="@dimen/qb_px_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/str_protocol_read_tips"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvReadProtocol"/>
    <View
        android:id="@+id/line"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTips"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="@color/color_cccccc"
        android:gravity="center"
        android:id="@+id/tvCancel"
        android:paddingTop="@dimen/qb_px_10"
        android:paddingBottom="@dimen/qb_px_10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/str_refuse"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/line_v"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
    <View
        android:id="@+id/line_v"
        android:background="@android:color/darker_gray"
        android:layout_width="0.5dp"
        android:layout_height="@dimen/qb_px_42"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="@color/colorAccent"
        android:gravity="center"
        android:id="@+id/tvSure"
        android:paddingTop="@dimen/qb_px_10"
        android:paddingBottom="@dimen/qb_px_10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/str_sure_enter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/line_v"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
