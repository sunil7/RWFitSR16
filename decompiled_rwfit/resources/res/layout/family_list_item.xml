<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/family_friend_border"
    android:paddingTop="@dimen/qb_px_13"
    android:paddingBottom="@dimen/qb_px_13"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/qb_px_16"
    android:layout_marginEnd="@dimen/qb_px_16">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/item_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/item_layout2"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/itemIcon"
                android:layout_width="@dimen/qb_px_40"
                android:layout_height="@dimen/qb_px_40"
                android:src="@mipmap/ic_avatar"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                android:gravity="center"
                android:id="@+id/item_content"
                android:layout_width="@dimen/qb_px_150"
                android:layout_height="match_parent"
                android:text="Item Text"
                android:layout_marginStart="@dimen/qb_px_10"/>
            <LinearLayout
                android:gravity="right"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/addRefuseButton"
                    android:background="@drawable/family_add_refuse"
                    android:visibility="gone"
                    android:layout_width="@dimen/qb_px_55"
                    android:layout_height="@dimen/qb_px_32"
                    android:layout_marginTop="@dimen/qb_px_2"
                    android:text="拒绝"
                    android:layout_marginEnd="@dimen/dp_10"/>
                <Button
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/addAgreeButton"
                    android:background="@drawable/family_add_agree"
                    android:visibility="gone"
                    android:layout_width="@dimen/qb_px_55"
                    android:layout_height="@dimen/qb_px_32"
                    android:layout_marginTop="@dimen/qb_px_2"
                    android:text="同意"/>
                <Button
                    android:id="@+id/modifyButton"
                    android:background="@drawable/svg_family_friend_modify"
                    android:visibility="gone"
                    android:layout_width="@dimen/qb_px_25"
                    android:layout_height="@dimen/qb_px_25"
                    android:layout_marginTop="@dimen/qb_px_8"
                    android:layout_marginEnd="@dimen/qb_px_16"/>
            </LinearLayout>
        </LinearLayout>
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"
            android:id="@+id/item_delete"
            android:background="@drawable/family_delete"
            android:layout_width="@dimen/qb_px_55"
            android:layout_height="@dimen/qb_px_42"
            android:layout_marginTop="@dimen/qb_px_2"
            android:text="删除"/>
    </LinearLayout>
</RelativeLayout>
