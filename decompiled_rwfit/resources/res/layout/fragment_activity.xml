<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintLayout"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.testui.TRingToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_option2="@drawable/svg_ic_tb_share"
        app:bar_status_res="@drawable/svg_ic_tb_back"
        app:bar_title="@string/str_ring_home_activity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.example.test.ui.testui.TRingDateSelectView
        android:id="@+id/view_date_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.haibin.calendarview.CalendarLayout
        android:orientation="vertical"
        android:id="@+id/week_calendar_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:calendar_show_mode="only_week_view"
        app:default_status="shrink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_date_select">
        <com.haibin.calendarview.CalendarView
            android:id="@+id/weekCalendarView"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:calendar_height="44dp"
            app:calendar_padding="5dp"
            app:current_day_text_color="@color/colorPrimaryDark"
            app:current_month_text_color="?attr/colorOnPrimary"
            app:day_text_size="14sp"
            app:min_year="2004"
            app:month_view="com.example.test.ui.view.calendar.SimpleMonthView"
            app:month_view_show_mode="mode_fix"
            app:other_month_text_color="@color/color_828282"
            app:scheme_month_text_color="#ff30cc"
            app:scheme_text_color="@color/color_3cfff"
            app:selected_text_color="@color/color_white"
            app:selected_theme_color="@android:color/holo_blue_light"
            app:week_background="@null"
            app:week_bar_height="@dimen/qb_px_24"
            app:week_bar_view="com.example.test.ui.view.calendar.CustomWeekBar"
            app:week_line_margin="1dp"
            app:week_text_color="?attr/colorOnPrimary"
            app:week_text_size="12sp"
            app:week_view="com.example.test.ui.view.calendar.SimpleWeekView"
            app:year_view_week_height="@dimen/qb_px_28"/>
    </com.haibin.calendarview.CalendarLayout>
    <ScrollView
        android:id="@+id/sv_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/week_calendar_2">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_info"
                android:background="@drawable/shape_background_theme"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_250"
                android:layout_marginTop="@dimen/qb_px_20"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <ImageView
                    android:id="@+id/iv_steptarget"
                    android:layout_width="@dimen/qb_px_25"
                    android:layout_height="@dimen/qb_px_25"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:src="@drawable/svg_ic_activitypage_share"
                    android:layout_alignParentRight="true"
                    android:layout_marginEnd="@dimen/qb_px_10"/>
                <com.example.test.ui.view.HalfCircle
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/deplete_progress"
                    android:layout_width="@dimen/qb_px_220"
                    android:layout_height="@dimen/qb_px_220"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="false"
                    android:layout_alignParentEnd="false"
                    app:bg_color="@color/ring_activitypage_red_mask"
                    app:fore_color="@color/ring_activitypage_red"
                    app:radius_len="40dp"
                    app:text_str=""
                    app:txt_size="40sp"/>
                <com.example.test.ui.view.HalfCircle
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/mileage_progress"
                    android:layout_width="@dimen/qb_px_180"
                    android:layout_height="@dimen/qb_px_180"
                    android:layout_marginTop="@dimen/qb_px_40"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="false"
                    android:layout_alignParentEnd="false"
                    app:bg_color="@color/ring_activitypage_green_mask"
                    app:fore_color="@color/ring_activitypage_green"
                    app:radius_len="40dp"
                    app:text_str=""
                    app:txt_size="40sp"/>
                <com.example.test.ui.view.HalfCircle
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/step_progress"
                    android:layout_width="@dimen/qb_px_140"
                    android:layout_height="@dimen/qb_px_140"
                    android:layout_marginTop="@dimen/qb_px_60"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="false"
                    android:layout_alignParentEnd="false"
                    app:bg_color="@color/ring_activitypage_blue_mask"
                    app:fore_color="@color/ring_activitypage_blue"
                    app:radius_len="40dp"
                    app:text_str=""
                    app:txt_size="40sp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/qb_px_20"
                    android:layout_alignParentBottom="true">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@color/ring_activitypage_blue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_total_step"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:id="@+id/tv_step_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <TextView
                            android:textSize="@dimen/qb_px_12"
                            android:textColor="@color/color_cccccc"
                            android:id="@+id/tv_target_step"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8000步"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@color/ring_activitypage_green"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_total_distance"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:id="@+id/tv_mileage_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <TextView
                            android:textSize="@dimen/qb_px_12"
                            android:textColor="@color/color_cccccc"
                            android:id="@+id/tv_target_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5.0千米"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="@color/ring_activitypage_red"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_total_cal"/>
                        <TextView
                            android:textSize="@dimen/qb_px_14"
                            android:textColor="?attr/colorOnPrimary"
                            android:id="@+id/tv_deplete_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <TextView
                            android:textSize="@dimen/qb_px_12"
                            android:textColor="@color/color_cccccc"
                            android:id="@+id/tv_target_calu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="200千卡"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_step_num"
                android:background="@drawable/shape_background_theme"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_250"
                android:layout_marginTop="@dimen/qb_px_20"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="@string/str_step"
                    android:layout_marginStart="@dimen/qb_px_10"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="false"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_step_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="00:00"
                    android:layout_marginEnd="@dimen/qb_px_10"
                    android:layout_alignParentStart="false"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="@dimen/qb_px_36"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_step_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_30"
                    android:text="0"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="@dimen/qb_px_10"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_step_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_45"
                    android:text="@string/str_unit_step"
                    android:layout_toRightOf="@+id/tv_step_num"
                    android:layout_marginStart="@dimen/qb_px_10"/>
                <RelativeLayout
                    android:id="@+id/rl_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_150"
                    android:layout_marginBottom="@dimen/qb_px_25"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20">
                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chart1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <com.example.test.ui.view.TimeIndicatorView
                        android:id="@+id/ll_time"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-12dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <com.example.test.ui.view.WaveView
                    android:id="@+id/wv_progress"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_230"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/qb_px_30"
                    android:layout_marginEnd="@dimen/qb_px_30"/>
            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="200dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
