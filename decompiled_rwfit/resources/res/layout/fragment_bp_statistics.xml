<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="@dimen/qb_px_10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.example.test.ui.view.DateSelectView
            android:id="@+id/view_date_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:textSize="@dimen/qb_px_24"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_item"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_280"
            android:layout_marginTop="@dimen/qb_px_10">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.example.test.ui.view.PointView
                    android:layout_width="@dimen/qb_px_10"
                    android:layout_height="@dimen/qb_px_10"
                    app:color_point="@color/color_d90fd2"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_sp"
                    android:layout_marginStart="@dimen/qb_px_10"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.example.test.ui.view.PointView
                    android:layout_width="@dimen/qb_px_10"
                    android:layout_height="@dimen/qb_px_10"
                    app:color_point="@color/color_29b7cb"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_dp"
                    android:layout_marginStart="@dimen/qb_px_10"/>
            </LinearLayout>
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_time"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp">
                <TextView
                    android:textSize="@dimen/qb_px_10"
                    android:textColor="@android:color/white"
                    android:id="@+id/start_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:layout_marginStart="@dimen/qb_px_15"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/qb_px_10"
                    android:textColor="@android:color/white"
                    android:id="@+id/end_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24:00"
                    android:layout_marginEnd="@dimen/qb_px_5"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_item"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10">
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_current_bp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_current_bp"
                app:data_value="--/--"/>
            <View
                android:id="@+id/current_line"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_avg_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_avg_bp"
                app:data_value="--/--"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_max_bp_sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_max_bp_sp"
                app:data_value="--"/>
            <View
                android:id="@+id/line_sleep"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_min_bp_sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_min_bp_sp"
                app:data_value="--"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_max_bp_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_max_bp_dp"
                app:data_value="--"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_min_bp_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_min_bp_dp"
                app:data_value="--"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_item"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            android:layout_marginBottom="@dimen/qb_px_20">
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_scien_tips"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_perface_bp_sp"
                app:data_value="＜120mmHg"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_perface_bp_dp"
                app:data_value="＜80mmHg"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_normal_bp_sp"
                app:data_value="90-140mmHg"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_normal_bp_dp"
                app:data_value="60-90mmHg"/>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_20"
                android:text="@string/str_bp_description"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
