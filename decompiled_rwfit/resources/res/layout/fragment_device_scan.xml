<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_hs_unbind"
    android:background="@color/color_131825"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_white"
        android:id="@+id/tv_hs_unbind_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:text="@string/headset_scan_title"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_hs_scan_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="@mipmap/hs_scan_icon"
        android:layout_below="@+id/tv_hs_unbind_title"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_white"
        android:id="@+id/tv_hs_unbind_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/headset_scan_tip"
        android:layout_below="@+id/iv_hs_scan_icon"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_white"
        android:id="@+id/tv_hs_scan_title"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/headset_scan_device_tip"
        android:layout_below="@+id/tv_hs_unbind_tip"
        android:layout_marginStart="24dp"/>
    <ImageView
        android:id="@+id/iv_hs_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="@mipmap/hs_scan_reflush"
        android:layout_toRightOf="@+id/tv_hs_scan_title"
        android:layout_alignTop="@+id/tv_hs_scan_title"
        android:layout_marginStart="6dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/deviceList"
        android:paddingBottom="@dimen/qb_px_10"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/tv_hs_scan_title"
        android:paddingStart="@dimen/qb_px_10"
        android:paddingEnd="@dimen/qb_px_10"/>
</RelativeLayout>
