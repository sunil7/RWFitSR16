<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_hs_navview"
        android:layout_width="match_parent"
        android:layout_height="64dp">
        <TextView
            android:textColor="@color/color_FEFEFE"
            android:id="@+id/tv_hs_navleft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/str_disconnected"
            android:layout_centerVertical="true"/>
        <TextView
            android:textColor="@color/color_FEFEFE"
            android:id="@+id/tv_hs_navtitle"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/tv_hs_navlist"
            android:padding="10dp"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:layout_marginRight="16dp"
            android:src="@mipmap/hs_nav_list"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_head_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="@mipmap/hs_head_icon"
        android:layout_centerHorizontal="true"/>
    <ProgressBar
        android:id="@+id/pb_hs_battery_right"
        android:layout_width="50dp"
        android:layout_height="3dp"
        android:layout_marginBottom="40dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/shape_hs_progress"
        android:layout_alignBottom="@+id/iv_head_icon"
        android:layout_centerHorizontal="true"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_e6e6e6"
        android:id="@+id/tv_hs_battery_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="R50%"
        android:layout_alignBottom="@+id/iv_head_icon"
        android:layout_centerHorizontal="true"/>
    <ProgressBar
        android:id="@+id/pb_hs_battery_left"
        android:layout_width="50dp"
        android:layout_height="3dp"
        android:layout_marginRight="20dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/shape_hs_progress"
        android:layout_toLeftOf="@+id/pb_hs_battery_right"
        android:layout_alignTop="@+id/pb_hs_battery_right"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_e6e6e6"
        android:gravity="center_horizontal"
        android:id="@+id/tv_hs_battery_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="L50%"
        android:layout_below="@+id/pb_hs_battery_left"
        android:layout_alignLeft="@+id/pb_hs_battery_left"
        android:layout_alignRight="@+id/pb_hs_battery_left"/>
    <ProgressBar
        android:id="@+id/pb_hs_battery_case"
        android:layout_width="50dp"
        android:layout_height="3dp"
        android:layout_marginLeft="20dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/shape_hs_progress"
        android:layout_toRightOf="@+id/pb_hs_battery_right"
        android:layout_alignTop="@+id/pb_hs_battery_right"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_battery_case"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/pb_hs_battery_case"
        android:layout_alignLeft="@+id/pb_hs_battery_case"
        android:layout_alignRight="@+id/pb_hs_battery_case">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:src="@mipmap/hs_battery_icon"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_e6e6e6"
            android:gravity="center_horizontal"
            android:id="@+id/tv_hs_battery_case"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text=" 50%"
            android:layout_below="@+id/pb_hs_battery_left"
            android:layout_alignLeft="@+id/pb_hs_battery_left"
            android:layout_alignRight="@+id/pb_hs_battery_left"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/sv_headset"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/iv_head_icon">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_headset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_hs_equalizer"
                android:background="@drawable/shape_hs_item_bg"
                android:layout_width="match_parent"
                android:layout_height="178dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_below="@+id/iv_head_icon">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/tv_hs_equalizer_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="13dp"
                    android:layout_marginTop="13dp"
                    android:text="@string/headset_eq_title"/>
                <ImageView
                    android:id="@+id/iv_hs_equalizer_bg"
                    android:layout_width="154dp"
                    android:layout_height="140dp"
                    android:layout_marginBottom="5dp"
                    android:src="@mipmap/hs_equalizer_bg1"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/tv_hs_eq_title1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    android:text="@string/headset_eq_normal"
                    android:layout_toLeftOf="@+id/iv_hs_equalizer_bg"
                    android:layout_alignBottom="@+id/iv_hs_equalizer_bg"
                    android:layout_marginEnd="-3dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/tv_hs_eq_title2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/headset_eq_rock"
                    android:layout_toLeftOf="@+id/iv_hs_equalizer_bg"
                    android:layout_alignTop="@+id/iv_hs_equalizer_bg"
                    android:layout_marginEnd="1dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/color_e6e6e6"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_hs_eq_title3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/headset_eq_pop"
                    android:layout_above="@+id/iv_hs_equalizer_bg"
                    android:layout_alignStart="@+id/iv_hs_equalizer_bg"
                    android:layout_alignEnd="@+id/iv_hs_equalizer_bg"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/tv_hs_eq_title4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/headset_eq_classic"
                    android:layout_toRightOf="@+id/iv_hs_equalizer_bg"
                    android:layout_alignTop="@+id/iv_hs_equalizer_bg"
                    android:layout_marginStart="1dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/tv_hs_eq_title5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    android:text="@string/headset_eq_jazz"
                    android:layout_toRightOf="@+id/iv_hs_equalizer_bg"
                    android:layout_alignBottom="@+id/iv_hs_equalizer_bg"/>
                <View
                    android:id="@+id/view_hs_eq_click1"
                    android:layout_width="97dp"
                    android:layout_height="50dp"
                    android:layout_alignBottom="@+id/iv_hs_equalizer_bg"
                    android:layout_marginStart="-20dp"
                    android:layout_alignStart="@+id/iv_hs_equalizer_bg"/>
                <View
                    android:id="@+id/view_hs_eq_click2"
                    android:layout_width="97dp"
                    android:layout_height="50dp"
                    android:layout_above="@+id/view_hs_eq_click1"
                    android:layout_alignStart="@+id/view_hs_eq_click1"/>
                <View
                    android:id="@+id/view_hs_eq_click4"
                    android:layout_width="97dp"
                    android:layout_height="50dp"
                    android:layout_toRightOf="@+id/view_hs_eq_click2"
                    android:layout_alignTop="@+id/view_hs_eq_click2"/>
                <View
                    android:id="@+id/view_hs_eq_click5"
                    android:layout_width="97dp"
                    android:layout_height="50dp"
                    android:layout_toRightOf="@+id/view_hs_eq_click2"
                    android:layout_alignTop="@+id/view_hs_eq_click1"/>
                <View
                    android:id="@+id/view_hs_eq_click3"
                    android:layout_width="80dp"
                    android:layout_height="60dp"
                    android:layout_above="@+id/view_hs_eq_click4"
                    android:layout_marginStart="55dp"
                    android:layout_alignStart="@+id/view_hs_eq_click2"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_hs_brightness"
                android:background="@drawable/shape_hs_item_bg"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="16dp"
                android:layout_below="@+id/rl_hs_equalizer">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/tv_hs_brightness_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="13dp"
                    android:layout_marginTop="13dp"
                    android:text="@string/headset_bright_title"/>
                <SeekBar
                    android:id="@+id/pb_hs_brightness"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="50"
                    android:thumb="@drawable/shape_hs_thumb"
                    android:layout_below="@+id/tv_hs_brightness_title"
                    android:min="0"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_hs_finddev"
                android:background="@drawable/shape_hs_item_bg"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="16dp"
                android:layout_below="@+id/rl_hs_brightness">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/tv_hs_finddev_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="13dp"
                    android:layout_marginTop="13dp"
                    android:text="@string/headset_item_title_find"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="13dp"
                    android:src="@mipmap/hs_item_right"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_hs_ota"
                android:background="@drawable/shape_hs_item_bg"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="40dp"
                android:layout_below="@+id/rl_hs_finddev"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/tv_hs_ota_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="13dp"
                    android:layout_marginTop="13dp"
                    android:text="@string/str_ota"/>
                <ImageView
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="13dp"
                    android:src="@mipmap/hs_item_right"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <View
                    android:id="@+id/view_hs_ota_point"
                    android:background="@drawable/bg_circle_red"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginRight="13dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_e6e6e6"
                    android:id="@+id/tv_hs_ota_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="V1.0.0"
                    android:layout_toLeftOf="@+id/view_hs_ota_point"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
