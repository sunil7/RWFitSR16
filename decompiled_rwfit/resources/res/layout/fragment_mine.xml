<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_item"
            android:padding="@dimen/qb_px_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:textSize="@dimen/qb_px_16"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/avatarIv"
                android:layout_width="@dimen/qb_px_120"
                android:layout_height="@dimen/qb_px_120"/>
            <TextView
                android:textSize="@dimen/qb_px_16"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:id="@+id/userNameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_16"
                android:text="@string/str_unset"
                android:maxLines="1"
                android:layout_marginStart="@dimen/qb_px_48"
                android:layout_marginEnd="@dimen/qb_px_48"/>
        </LinearLayout>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/qrCodeAv"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            app:item_name="@string/str_qrcode"
            app:item_resource="@mipmap/ic_person_qr_code"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/personalAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            app:item_name="@string/str_personal_data"
            app:item_resource="@mipmap/ic_personal_info"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/settingAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            app:item_name="@string/str_setting"
            app:item_resource="@mipmap/ic_setting"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/suggestAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            app:item_name="@string/str_suggest"
            app:item_resource="@mipmap/ic_feedback"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/checkVersionAv"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            app:is_show_point="false"
            app:item_name="@string/str_app_version_check"
            app:item_resource="@mipmap/ic_app_update"
            app:item_type="action_info"/>
        <com.example.test.ui.view.ActionItemView
            android:id="@+id/aboutAv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            app:item_name="@string/str_about"
            app:item_resource="@mipmap/ic_about"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
