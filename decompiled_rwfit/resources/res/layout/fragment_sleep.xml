<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintLayout"
    android:background="?attr/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.example.test.ui.testui.TRingToolBarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_option1="@drawable/svg_ic_activitypage_share"
        app:bar_status_res="@drawable/svg_ic_tb_back"
        app:bar_title="@string/str_sleep_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.example.test.ui.testui.TRingDateSelectView
        android:id="@+id/view_date_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <com.haibin.calendarview.CalendarLayout
        android:orientation="vertical"
        android:id="@+id/week_calendar_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:calendar_show_mode="only_week_view"
        app:default_status="shrink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_date_select">
        <com.haibin.calendarview.CalendarView
            android:id="@+id/weekCalendarView"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            app:calendar_height="44dp"
            app:calendar_padding="5dp"
            app:current_day_text_color="@color/color_white"
            app:current_month_text_color="?attr/colorOnPrimary"
            app:day_text_size="14sp"
            app:min_year="2020"
            app:month_view="com.example.test.ui.view.calendar.SimpleMonthView"
            app:month_view_show_mode="mode_fix"
            app:other_month_text_color="@color/color_828282"
            app:scheme_month_text_color="#ff30cc"
            app:scheme_text_color="@color/color_3cfff"
            app:selected_text_color="@color/color_white"
            app:selected_theme_color="#6819ff"
            app:week_background="@null"
            app:week_bar_height="@dimen/qb_px_24"
            app:week_bar_view="com.example.test.ui.view.calendar.CustomWeekBar"
            app:week_line_margin="1dp"
            app:week_text_color="?attr/colorOnPrimary"
            app:week_text_size="12sp"
            app:week_view="com.example.test.ui.view.calendar.SimpleWeekView"
            app:year_view_week_height="@dimen/qb_px_28"/>
    </com.haibin.calendarview.CalendarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/week_calendar_2">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rl_sleep_info"
                android:background="@drawable/shape_background_theme"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_380"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/rl_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="@string/str_total_sleep_time"
                    android:layout_marginStart="@dimen/qb_px_20"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_sleep_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_15"
                    android:layout_below="@+id/rl_title"
                    android:layout_marginStart="@dimen/qb_px_20">
                    <TextView
                        android:textSize="@dimen/qb_px_20"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        android:id="@+id/tv_hour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:layout_below="@+id/icon"
                        android:layout_marginStart="@dimen/qb_px_8"/>
                    <TextView
                        android:textSize="@dimen/qb_px_20"
                        android:textColor="?attr/colorOnPrimary"
                        android:id="@+id/tv_hour_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/qb_px_2"
                        android:text="H"
                        android:layout_alignBottom="@+id/tv_hour"
                        android:layout_marginStart="@dimen/qb_px_2"
                        android:layout_toEndOf="@+id/tv_hour"/>
                    <TextView
                        android:textSize="@dimen/qb_px_20"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        android:id="@+id/tv_min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:layout_below="@+id/icon"
                        android:layout_marginStart="@dimen/qb_px_2"
                        android:layout_toEndOf="@+id/tv_hour_unit"/>
                    <TextView
                        android:textSize="@dimen/qb_px_20"
                        android:textColor="?attr/colorOnPrimary"
                        android:id="@+id/tv_min_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/qb_px_2"
                        android:text="M"
                        android:layout_alignBottom="@+id/tv_hour"
                        android:layout_marginStart="@dimen/qb_px_2"
                        android:layout_toEndOf="@+id/tv_min"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_start_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:text="--:--"
                    android:layout_below="@+id/ll_sleep_time"
                    android:layout_marginStart="@dimen/qb_px_20"/>
                <RelativeLayout
                    android:layout_width="@dimen/qb_px_120"
                    android:layout_height="@dimen/qb_px_120"
                    android:layout_marginTop="@dimen/qb_px_12"
                    android:layout_marginBottom="@dimen/qb_px_12"
                    android:layout_marginEnd="23dp"
                    android:layout_alignParentEnd="true">
                    <com.example.test.ui.view.NoThumbCircleProgressView
                        android:id="@+id/sleep_progress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="0dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="-1dp"
                        android:layout_alignParentEnd="true"/>
                    <TextView
                        android:textSize="@dimen/qb_px_30"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        android:id="@+id/tv_sleep_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_30"
                        android:text="--"
                        android:layout_centerHorizontal="true"/>
                    <TextView
                        android:textSize="@dimen/qb_px_16"
                        android:textStyle="bold"
                        android:textColor="@color/ring_activitypage_text_mask"
                        android:id="@+id/tv_sleep_desc"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/qb_px_1"
                        android:text="中等"
                        android:layout_below="@+id/tv_sleep_progress"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <View
                    android:id="@+id/v_middle"
                    android:background="@mipmap/ic_sleeppage_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_1"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:layout_below="@+id/tv_start_time"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20"/>
                <TextView
                    android:textSize="@dimen/qb_px_40"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/tv_awake_time"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:text="--"
                    android:layout_below="@+id/v_middle"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_awake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_25"
                    android:text="@string/str_wake_up"
                    android:layout_below="@+id/v_middle"
                    android:layout_marginEnd="@dimen/qb_px_20"
                    android:layout_toStartOf="@+id/tv_awake_time"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_min_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_25"
                    android:text="@string/str_mins"
                    android:layout_below="@+id/v_middle"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_toEndOf="@+id/tv_awake_time"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/qb_px_12"
                    android:layout_below="@+id/tv_awake_time"
                    android:layout_marginStart="@dimen/qb_px_40"
                    android:layout_marginEnd="@dimen/qb_px_40">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/rapidCircle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="@dimen/qb_px_10"
                            android:layout_height="@dimen/qb_px_10"
                            android:src="@mipmap/point_bright_purple"/>
                        <TextView
                            android:textSize="@dimen/qb_px_12"
                            android:textColor="@color/ring_activitypage_text_mask"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_rapid_eye"
                            android:layout_marginStart="@dimen/qb_px_5"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="@dimen/qb_px_10"
                            android:layout_height="@dimen/qb_px_10"
                            android:src="@mipmap/point_yellow"/>
                        <TextView
                            android:textSize="@dimen/qb_px_12"
                            android:textColor="@color/ring_activitypage_text_mask"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_wake_up"
                            android:layout_marginStart="@dimen/qb_px_5"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="@dimen/qb_px_10"
                            android:layout_height="@dimen/qb_px_10"
                            android:src="@mipmap/point_purper"/>
                        <TextView
                            android:textSize="@dimen/qb_px_12"
                            android:textColor="@color/ring_activitypage_text_mask"
                            android:id="@+id/tv_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_light_sleep"
                            android:layout_marginStart="@dimen/qb_px_5"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="@dimen/qb_px_10"
                            android:layout_height="@dimen/qb_px_10"
                            android:src="@mipmap/point_blue"/>
                        <TextView
                            android:textSize="@dimen/qb_px_12"
                            android:textColor="@color/ring_activitypage_text_mask"
                            android:id="@+id/tv_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_deep_sleep"
                            android:layout_marginStart="@dimen/qb_px_5"/>
                    </LinearLayout>
                </LinearLayout>
                <com.example.test.ui.view.TRingSleepChartView
                    android:id="@+id/daySleepChart"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="@dimen/qb_px_20"
                    android:layout_below="@+id/ll_desc"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_bottom_starttime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:text="--:--"
                    android:layout_alignParentBottom="true"
                    android:layout_alignStart="@+id/daySleepChart"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_bottom_endtime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:text="--:--"
                    android:layout_alignParentBottom="true"
                    android:layout_alignEnd="@+id/daySleepChart"/>
                <com.example.test.ui.view.WaveView
                    android:id="@+id/wv_progress"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_230"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/qb_px_30"
                    android:layout_marginEnd="@dimen/qb_px_30"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/v_bottom"
                android:background="@drawable/shape_background_theme"
                android:paddingBottom="@dimen/qb_px_25"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_20"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_rapid_sleep_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="@string/str_rapid_eye_time"
                    android:layout_marginStart="@dimen/qb_px_20"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/v_rapid_sleep_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="-- Min"
                    android:layout_marginStart="@dimen/qb_px_5"
                    android:layout_toEndOf="@+id/tv_rapid_sleep_title"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_rapid_sleep_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_25"
                    android:text="--%"
                    android:layout_alignBottom="@+id/v_rapid_sleep_value"
                    android:layout_marginStart="@dimen/qb_px_5"
                    android:layout_toEndOf="@+id/v_rapid_sleep_value"/>
                <ProgressBar
                    android:id="@+id/pb_rapid_sleep"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_20"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:progressDrawable="@drawable/shape_hs_progress_purper_deep"
                    android:layout_below="@+id/tv_rapid_sleep_title"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20"
                    style="@android:style/Widget.ProgressBar.Horizontal"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/v_awake_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="@string/str_wake_timelong"
                    android:layout_below="@+id/pb_rapid_sleep"
                    android:layout_marginStart="@dimen/qb_px_20"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/v_awake_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="-- Min"
                    android:layout_below="@+id/pb_rapid_sleep"
                    android:layout_marginStart="@dimen/qb_px_5"
                    android:layout_toEndOf="@+id/v_awake_title"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_awake_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_25"
                    android:text="--%"
                    android:layout_alignBottom="@+id/v_awake_value"
                    android:layout_marginStart="@dimen/qb_px_5"
                    android:layout_toEndOf="@+id/v_awake_value"/>
                <ProgressBar
                    android:id="@+id/pb_awake"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_20"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:progressDrawable="@drawable/shape_hs_progress_yellow"
                    android:layout_below="@+id/v_awake_title"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20"
                    style="@android:style/Widget.ProgressBar.Horizontal"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_lightsleep_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="@string/str_light_time"
                    android:layout_below="@+id/pb_awake"
                    android:layout_marginStart="@dimen/qb_px_20"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/v_lightsleep_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="-- Min"
                    android:layout_below="@+id/pb_awake"
                    android:layout_marginStart="@dimen/qb_px_5"
                    android:layout_toEndOf="@+id/tv_lightsleep_title"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_lightsleep_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_25"
                    android:text="--%"
                    android:layout_alignBottom="@+id/v_lightsleep_value"
                    android:layout_marginStart="@dimen/qb_px_5"
                    android:layout_toEndOf="@+id/v_lightsleep_value"/>
                <ProgressBar
                    android:id="@+id/pb_lightsleep"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_20"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:progressDrawable="@drawable/shape_hs_progress_purper"
                    android:layout_below="@+id/tv_lightsleep_title"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20"
                    style="@android:style/Widget.ProgressBar.Horizontal"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_deepsleep_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="@string/str_deep_time"
                    android:layout_below="@+id/pb_lightsleep"
                    android:layout_marginStart="@dimen/qb_px_20"/>
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/v_deepsleep_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="-- Min"
                    android:layout_below="@+id/pb_lightsleep"
                    android:layout_marginStart="@dimen/qb_px_5"
                    android:layout_toEndOf="@+id/tv_deepsleep_title"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@color/ring_activitypage_text_mask"
                    android:id="@+id/tv_deepsleep_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_25"
                    android:text="--%"
                    android:layout_alignBottom="@+id/v_deepsleep_value"
                    android:layout_marginStart="@dimen/qb_px_5"
                    android:layout_toEndOf="@+id/v_deepsleep_value"/>
                <ProgressBar
                    android:id="@+id/pb_deepsleep"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_20"
                    android:layout_marginTop="@dimen/qb_px_10"
                    android:progressDrawable="@drawable/shape_hs_progress_blue"
                    android:layout_below="@+id/tv_deepsleep_title"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_marginEnd="@dimen/qb_px_20"
                    style="@android:style/Widget.ProgressBar.Horizontal"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_sleep_target_info"
                android:background="@drawable/shape_background_theme"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_140"
                android:layout_marginTop="@dimen/qb_px_20"
                android:layout_marginStart="@dimen/qb_px_10"
                android:layout_marginEnd="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_16"
                    android:textColor="?attr/colorOnPrimary"
                    android:id="@+id/rl_target_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_20"
                    android:text="@string/str_ring_sleep_goal_time"
                    android:layout_marginStart="@dimen/qb_px_20"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_target_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_15"
                    android:layout_marginStart="@dimen/qb_px_20"
                    android:layout_toEndOf="@+id/rl_target_time">
                    <TextView
                        android:textSize="@dimen/qb_px_20"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        android:id="@+id/tv_target_hour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:layout_below="@+id/icon"
