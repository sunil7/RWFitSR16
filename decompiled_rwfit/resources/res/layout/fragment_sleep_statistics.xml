<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="@dimen/qb_px_10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.example.test.ui.view.DateSelectView
            android:id="@+id/view_date_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:textSize="@dimen/qb_px_24"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_day"
            android:background="@drawable/bg_item"
            android:padding="@dimen/qb_px_10"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_280"
            android:layout_marginTop="@dimen/qb_px_10">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.example.test.ui.view.PointView
                    android:layout_width="@dimen/qb_px_10"
                    android:layout_height="@dimen/qb_px_10"
                    app:color_point="@color/color_925ed2"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_deep_sleep"
                    android:layout_marginStart="@dimen/qb_px_10"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.example.test.ui.view.PointView
                    android:layout_width="@dimen/qb_px_10"
                    android:layout_height="@dimen/qb_px_10"
                    app:color_point="@color/color_3d56bf"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_light_sleep"
                    android:layout_marginStart="@dimen/qb_px_10"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.example.test.ui.view.PointView
                    android:layout_width="@dimen/qb_px_10"
                    android:layout_height="@dimen/qb_px_10"
                    app:color_point="@color/color_fbb612"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_wake_up"
                    android:layout_marginStart="@dimen/qb_px_10"/>
            </LinearLayout>
            <com.example.test.ui.view.SleepDetailChartView
                android:id="@+id/daySleepChart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_day_no_data"
            android:background="@drawable/bg_item"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_280"
            android:text="@string/str_no_data"/>
        <LinearLayout
            android:textSize="@dimen/qb_px_24"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_statistics"
            android:background="@drawable/bg_item"
            android:padding="@dimen/qb_px_10"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_280"
            android:layout_marginTop="@dimen/qb_px_10">
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/chart1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_item"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10">
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_total_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_total_sleep_time"
                app:data_value="00H00M"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_deep_sleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_deep_time"
                app:data_value="00H00M"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_light_sleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_light_time"
                app:data_value="00H00M"/>
            <View
                android:id="@+id/line_sleep"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_sleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_sleep_time"
                app:data_value="--:--"/>
            <View
                android:id="@+id/line_wake"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_wake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_wake_time"
                app:data_value="--:--"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_wake_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_wake_time"
                app:data_value="--"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_item"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            android:layout_marginBottom="@dimen/qb_px_20">
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_scien_tips"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_avg_sleep_time"
                app:data_value="6-9H"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_avg_deep_sleep_percent"
                app:data_value="20-60%"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_avg_light_sleep_percent"
                app:data_value="＜55%"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_avg_wake_sleep_percent"
                app:data_value="10-33%"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_avg_flow_sleep_time"
                app:data_value="21:00-24:00"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                android:layout_marginBottom="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:data_name="@string/str_avg_flow_wake_time"
                app:data_value="06:00-08:00"/>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_20"
                android:text="@string/str_medical_tips"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
