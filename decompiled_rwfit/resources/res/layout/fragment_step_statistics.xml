<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="@dimen/qb_px_10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.example.test.ui.view.DateSelectView
            android:id="@+id/view_date_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:textSize="@dimen/qb_px_24"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_item"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_280"
            android:layout_marginTop="@dimen/qb_px_10"
            android:text="统计图表">
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/chart1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.example.test.ui.view.TimeIndicatorView
                android:id="@+id/ll_time"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_item"
            android:padding="@dimen/qb_px_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_44"
                android:layout_marginBottom="@dimen/qb_px_16">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_step_total"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="@android:color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/str_total_step"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/qb_px_8"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_total_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2015步"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_avg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="@android:color/white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/str_day_avg_step"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_avg_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3002步"/>
            </LinearLayout>
            <com.example.test.ui.view.RoundProgressBar
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_24"
                android:layout_marginTop="@dimen/qb_px_10"
                app:bar_progress="0"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_14"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_target"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="目标：10000步"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/targetEditIv"
                    android:visibility="gone"
                    android:layout_width="@dimen/qb_px_24"
                    android:layout_height="@dimen/qb_px_24"
                    android:src="@mipmap/ic_edit"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_calorie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                app:data_name="@string/str_cost_cal"
                app:data_value="0.00KCAL"/>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/qb_px_10"
                style="@style/style_horizontal_line"/>
            <com.example.test.ui.view.DataView
                android:id="@+id/dv_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                app:data_name="@string/str_distance"
                app:data_value="0.00KM"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
