<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@drawable/bg_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_64">
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:id="@+id/nameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:text="Mr.Coolper"
        android:layout_marginStart="@dimen/qb_px_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_12"
        android:textColor="@android:color/white"
        android:id="@+id/contactTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        android:layout_marginBottom="@dimen/qb_px_10"
        android:text="15563423545"
        android:layout_marginStart="@dimen/qb_px_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <View
        android:id="@+id/convert"
        android:background="@android:color/white"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_10"
        android:layout_height="match_parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
