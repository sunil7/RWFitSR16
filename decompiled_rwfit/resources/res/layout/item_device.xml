<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_item"
    android:padding="@dimen/qb_px_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.example.test.ui.view.GpsSingleView
        android:id="@+id/ble_rssi"
        android:layout_width="@dimen/qb_px_20"
        android:layout_height="@dimen/qb_px_20"
        android:layout_marginEnd="@dimen/qb_px_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_ble_type"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@mipmap/ring_icon_type1"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ble_rssi"
        app:layout_constraintRight_toLeftOf="@+id/ble_rssi"
        app:layout_constraintTop_toTopOf="@+id/ble_rssi"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:id="@+id/ble_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BLE NAME"
        android:layout_marginStart="@dimen/qb_px_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:id="@+id/tv_ble_mac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:text="0A:0B:9C:AA:7F:4A"
        android:layout_marginStart="@dimen/qb_px_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ble_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
