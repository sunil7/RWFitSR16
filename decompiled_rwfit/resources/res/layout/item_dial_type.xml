<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_item"
    android:padding="@dimen/qb_px_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/qb_px_16"
            android:textColor="@android:color/white"
            android:id="@+id/dialTypeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_dialo_hot"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@color/color_cccccc"
            android:gravity="end"
            android:id="@+id/moreTv"
            android:paddingBottom="@dimen/qb_px_10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/str_more"
            android:layout_weight="1"/>
        <ImageView
            android:textSize="@dimen/qb_px_16"
            android:textColor="@android:color/white"
            android:layout_width="@dimen/qb_px_18"
            android:layout_height="@dimen/qb_px_24"
            android:src="@mipmap/ic_back"
            android:text="&gt;"
            android:rotation="180"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dial_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
