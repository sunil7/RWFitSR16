<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/imgIv"
        android:layout_width="@dimen/qb_px_84"
        android:layout_height="@dimen/qb_px_84"
        android:layout_marginTop="@dimen/qb_px_18"
        android:src="@android:drawable/ic_menu_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/tag"
        android:layout_width="@dimen/qb_px_1"
        android:layout_height="@dimen/qb_px_1"
        android:layout_marginStart="@dimen/qb_px_18"
        app:layout_constraintLeft_toRightOf="@+id/imgIv"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/clearIv"
        android:padding="@dimen/qb_px_4"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_36"
        android:layout_height="@dimen/qb_px_36"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintEnd_toEndOf="@+id/tag"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
