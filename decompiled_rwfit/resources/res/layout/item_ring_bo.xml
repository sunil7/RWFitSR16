<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bo_content"
    android:background="@mipmap/homepage_bo_bg"
    android:padding="@dimen/qb_px_12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_270">
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_12"
        android:text="@string/str_bo_title"
        android:layout_marginStart="@dimen/qb_px_13"
        android:layout_alignParentEnd="false"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_white"
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_3"
        android:text="2025年3月13日"
        android:layout_below="@+id/item_name"
        android:layout_marginStart="@dimen/qb_px_13"/>
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="@dimen/qb_px_20"
        android:layout_height="@dimen/qb_px_20"
        android:layout_marginTop="@dimen/qb_px_20"
        android:src="@mipmap/ic_homepage_more"
        android:layout_marginEnd="@dimen/qb_px_10"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/qb_px_12"
        android:textColor="@color/color_cccccc"
        android:id="@+id/tv_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qb_px_2"
        android:text="%"
        android:layout_alignBottom="@+id/tv_current_bo"
        android:layout_marginStart="@dimen/qb_px_2"
        android:layout_toEndOf="@+id/tv_current_bo"/>
    <RelativeLayout
        android:id="@+id/rl_lineChart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_date"
        android:layout_marginStart="@dimen/qb_px_20"
        android:layout_marginEnd="@dimen/qb_px_20">
        <com.example.test.ui.view.LineGradientChartView
            android:id="@+id/lineChart"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="100dp"/>
        <TextView
            android:textSize="@dimen/qb_px_10"
            android:textColor="@color/color_cccccc"
            android:id="@+id/tv_no_data"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_no_data"
            android:layout_centerInParent="true"/>
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_120"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_time"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_15"
            android:layout_below="@+id/chart1"
            android:layout_marginStart="@dimen/qb_px_10"
            android:layout_marginEnd="@dimen/qb_px_10">
            <TextView
                android:textSize="@dimen/qb_px_10"
                android:textColor="@color/color_white"
                android:id="@+id/start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:layout_marginStart="@dimen/qb_px_15"/>
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/qb_px_10"
                android:textColor="@color/color_white"
                android:id="@+id/end_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24:00"
                android:layout_marginEnd="@dimen/qb_px_5"/>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/qb_px_24"
        android:layout_height="@dimen/qb_px_24"
        android:layout_marginTop="@dimen/qb_px_20"
        android:src="@mipmap/ic_bo_blood"
        android:layout_below="@+id/rl_lineChart"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/qb_px_20"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:id="@+id/tv_current_bo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_20"
        android:text="--"
        android:layout_below="@+id/rl_lineChart"
        android:layout_marginStart="@dimen/qb_px_8"
        android:layout_toEndOf="@+id/icon"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="@color/color_cccccc"
        android:gravity="end"
        android:id="@+id/tv_range"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_20"
        android:text="aa"
        android:layout_below="@+id/rl_lineChart"
        android:layout_marginEnd="@dimen/qb_px_10"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
