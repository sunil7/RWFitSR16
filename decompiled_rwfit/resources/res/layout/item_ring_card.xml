<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <ImageView
        android:id="@+id/iv_outdoorrun"
        android:layout_width="@dimen/qb_px_30"
        android:layout_height="@dimen/qb_px_30"
        android:src="@drawable/svg_ic_tb_menu"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/qb_px_20"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/cardid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_tab_sport_running_outdoor"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/qb_px_20"
        android:layout_toEndOf="@+id/iv_outdoorrun"/>
    <ImageView
        android:id="@+id/cardsel"
        android:layout_width="@dimen/qb_px_20"
        android:layout_height="@dimen/qb_px_20"
        android:src="@mipmap/select_yes"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/qb_px_20"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="?attr/colorOnSecondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_1"
        android:layout_alignLeft="@+id/cardid"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/qb_px_10"/>
</RelativeLayout>
