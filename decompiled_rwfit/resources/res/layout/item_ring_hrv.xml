<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hr_content"
    android:background="@mipmap/homepage_heartrate"
    android:padding="@dimen/qb_px_12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_270">
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_12"
        android:text="@string/ring_str_hrv_title"
        android:layout_marginStart="@dimen/qb_px_13"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_white"
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_3"
        android:text="2025年3月13日"
        android:layout_below="@+id/item_name"
        android:layout_marginStart="@dimen/qb_px_13"/>
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="@dimen/qb_px_20"
        android:layout_height="@dimen/qb_px_20"
        android:layout_marginTop="@dimen/qb_px_20"
        android:src="@mipmap/ic_homepage_more"
        android:layout_marginEnd="@dimen/qb_px_10"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:id="@+id/rl_lineChart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/qb_px_20"
        android:layout_marginRight="@dimen/qb_px_20"
        android:layout_below="@+id/tv_date">
        <com.example.test.ui.view.LineGradientChartView
            android:id="@+id/lineChart"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_100"/>
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_120"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_time"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_15"
            android:layout_below="@+id/chart1">
            <TextView
                android:textSize="@dimen/qb_px_10"
                android:textColor="@color/color_white"
                android:id="@+id/start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/qb_px_10"
                android:text="00:00"/>
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/qb_px_10"
                android:textColor="@color/color_white"
                android:id="@+id/end_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/qb_px_10"
                android:text="24:00"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/qb_px_10"
            android:textColor="@color/color_white"
            android:id="@+id/tv_no_data"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_no_data"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_heart_hrv"
        android:layout_width="@dimen/qb_px_25"
        android:layout_height="@dimen/qb_px_25"
        android:layout_marginLeft="@dimen/qb_px_10"
        android:layout_marginTop="@dimen/qb_px_20"
        android:src="@mipmap/ic_heartrate_hrv"
        android:layout_below="@+id/rl_lineChart"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="@android:color/white"
        android:id="@+id/tv_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_20"
        android:text="-- ms"
        android:layout_below="@+id/rl_lineChart"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_toEndOf="@+id/iv_heart_hrv"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="@color/color_cccccc"
        android:id="@+id/tv_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_20"
        android:text="@string/ring_str_hrv_range_normal"
        android:layout_below="@+id/rl_lineChart"
        android:layout_marginEnd="@dimen/qb_px_10"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
