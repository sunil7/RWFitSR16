<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/muslin_content"
    android:background="@mipmap/homepage_muslim_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_250">
    <com.example.test.ui.view.HalfCircle
        android:layout_gravity="center_horizontal"
        android:id="@+id/pcycle_progress"
        android:layout_width="@dimen/qb_px_220"
        android:layout_height="@dimen/qb_px_220"
        android:layout_marginTop="@dimen/qb_px_30"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="false"
        android:layout_alignParentEnd="false"
        app:bg_color="@color/ring_progress_bg"
        app:fore_color="@color/color_white"
        app:radius_len="40dp"
        app:text_str=""
        app:txt_size="40sp"/>
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_12"
        android:text="@string/ring_muslimcount_title"
        android:layout_marginStart="@dimen/qb_px_13"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_3"
        android:text="2025年3月12日"
        android:layout_below="@+id/tv_title"
        android:layout_marginStart="@dimen/qb_px_13"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_desc"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_35"
        android:text="/6次"
        android:lines="2"
        android:layout_below="@+id/tv_title"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="@dimen/qb_px_20"
        android:layout_height="@dimen/qb_px_20"
        android:layout_marginTop="@dimen/qb_px_20"
        android:src="@mipmap/ic_homepage_more"
        android:layout_marginEnd="@dimen/qb_px_10"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:id="@+id/rl_period"
        android:background="@mipmap/button_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_30"
        android:layout_marginBottom="@dimen/qb_px_20"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/qb_px_50"
        android:layout_marginEnd="@dimen/qb_px_50">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@android:color/white"
                android:id="@+id/tv_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ring_muslimcount_clean"
                android:layout_centerInParent="true"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
