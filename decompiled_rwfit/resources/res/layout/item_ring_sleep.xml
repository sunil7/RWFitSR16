<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sleep_content"
    android:background="@mipmap/homepage_sleep_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_250">
    <com.example.test.ui.view.HalfCircle
        android:layout_gravity="center_horizontal"
        android:id="@+id/sleep_progress"
        android:layout_width="@dimen/qb_px_220"
        android:layout_height="@dimen/qb_px_220"
        android:layout_marginTop="@dimen/qb_px_30"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="false"
        android:layout_alignParentEnd="false"
        app:bg_color="@color/ring_progress_bg"
        app:fore_color="@color/color_white"
        app:radius_len="40dp"
        app:text_str=""
        app:txt_size="40sp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_40"
        android:layout_marginBottom="@dimen/qb_px_10"
        android:layout_above="@+id/ll_info">
        <ImageView
            android:id="@+id/segment_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/ring_home_sleep_len"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/qb_px_30"
            android:layout_marginEnd="@dimen/qb_px_30"/>
        <TextView
            android:textSize="@dimen/qb_px_12"
            android:textColor="@color/color_white"
            android:id="@+id/tv_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/qb_px_30"/>
        <TextView
            android:textSize="@dimen/qb_px_12"
            android:textColor="@color/color_white"
            android:id="@+id/tv_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:35"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/qb_px_30"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_alignParentEnd="false">
        <ImageView
            android:layout_width="@dimen/qb_px_24"
            android:layout_height="@dimen/qb_px_24"
            android:src="@mipmap/ic_homepage_sleep"/>
        <TextView
            android:textSize="@dimen/qb_px_20"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:id="@+id/tv_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:layout_below="@+id/icon"
            android:layout_marginStart="@dimen/qb_px_8"/>
        <TextView
            android:textSize="@dimen/qb_px_12"
            android:textColor="@color/color_cccccc"
            android:id="@+id/tv_hour_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/qb_px_2"
            android:text="H"
            android:layout_alignBottom="@+id/tv_hour"
            android:layout_marginStart="@dimen/qb_px_2"
            android:layout_toEndOf="@+id/tv_hour"/>
        <TextView
            android:textSize="@dimen/qb_px_20"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:id="@+id/tv_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:layout_below="@+id/icon"
            android:layout_marginStart="@dimen/qb_px_2"
            android:layout_toEndOf="@+id/tv_hour_unit"/>
        <TextView
            android:textSize="@dimen/qb_px_12"
            android:textColor="@color/color_cccccc"
            android:id="@+id/tv_min_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/qb_px_2"
            android:text="M"
            android:layout_alignBottom="@+id/tv_hour"
            android:layout_marginStart="@dimen/qb_px_2"
            android:layout_toEndOf="@+id/tv_min"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_12"
        android:text="@string/str_sleep_title"
        android:layout_marginStart="@dimen/qb_px_13"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_3"
        android:text="2025年3月12日"
        android:layout_below="@+id/item_name"
        android:layout_marginStart="@dimen/qb_px_13"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_desc"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_30"
        android:text=""
        android:lines="2"
        android:layout_below="@+id/item_name"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="@dimen/qb_px_20"
        android:layout_height="@dimen/qb_px_20"
        android:layout_marginTop="@dimen/qb_px_20"
        android:src="@mipmap/ic_homepage_more"
        android:layout_marginEnd="@dimen/qb_px_10"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
