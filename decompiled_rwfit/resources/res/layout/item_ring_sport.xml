<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/step_content"
    android:background="@mipmap/ring_homepage_sport_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_250">
    <com.example.test.ui.view.HalfCircle
        android:layout_gravity="center_horizontal"
        android:id="@+id/step_progress"
        android:layout_width="@dimen/qb_px_220"
        android:layout_height="@dimen/qb_px_220"
        android:layout_marginTop="@dimen/qb_px_30"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="false"
        android:layout_alignParentEnd="false"
        app:bg_color="@color/ring_progress_bg"
        app:fore_color="@color/color_white"
        app:radius_len="40dp"
        app:text_str="--"
        app:txt_size="40sp"/>
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_12"
        android:text="@string/str_sport_record"
        android:layout_marginStart="@dimen/qb_px_13"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_3"
        android:text="2025年3月12日"
        android:layout_below="@+id/tv_title"
        android:layout_marginStart="@dimen/qb_px_13"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_desc"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_35"
        android:text="千卡"
        android:lines="2"
        android:layout_below="@+id/tv_title"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="@dimen/qb_px_20"
        android:layout_height="@dimen/qb_px_20"
        android:layout_marginTop="@dimen/qb_px_20"
        android:src="@mipmap/ic_homepage_more"
        android:layout_marginEnd="@dimen/qb_px_10"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/tv_sport_gorun"
        android:background="@mipmap/ring_sport_gorun_bg"
        android:layout_width="290dp"
        android:layout_height="38dp"
        android:layout_marginBottom="20dp"
        android:text="@string/str_ring_run_go"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_above="@+id/tv_sport_gorun"
        android:layout_alignStart="@+id/step_progress"
        android:layout_alignEnd="@+id/step_progress">
        <ImageView
            android:id="@+id/iv_ring_sport_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ring_ic_sport_time"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@android:color/white"
            android:id="@+id/tv_ring_sport_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:layout_marginStart="@dimen/dp_4"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_ring_sport_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_step_km"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@android:color/white"
            android:id="@+id/tv_ring_sport_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:layout_marginStart="@dimen/dp_4"/>
    </LinearLayout>
</RelativeLayout>
