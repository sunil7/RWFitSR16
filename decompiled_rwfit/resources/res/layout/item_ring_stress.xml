<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/stress_content"
    android:background="@mipmap/homepage_stress_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_250">
    <com.example.test.ui.view.HalfCircle
        android:layout_gravity="center_horizontal"
        android:id="@+id/stress_progress"
        android:layout_width="@dimen/qb_px_220"
        android:layout_height="@dimen/qb_px_220"
        android:layout_marginTop="@dimen/qb_px_30"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="false"
        android:layout_alignParentEnd="false"
        app:bg_color="@color/ring_progress_bg"
        app:fore_color="@color/color_white"
        app:radius_len="40dp"
        app:text_str=""
        app:txt_size="40sp"/>
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_12"
        android:text="@string/str_press_title"
        android:layout_marginStart="@dimen/qb_px_13"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_3"
        android:text="2025年3月12日"
        android:layout_below="@+id/tv_title"
        android:layout_marginStart="@dimen/qb_px_13"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_desc"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_35"
        android:text="@string/str_normal_press_range"
        android:lines="2"
        android:layout_below="@+id/tv_title"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="@dimen/qb_px_20"
        android:layout_height="@dimen/qb_px_20"
        android:layout_marginTop="@dimen/qb_px_20"
        android:src="@mipmap/ic_homepage_more"
        android:layout_marginEnd="@dimen/qb_px_10"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qb_px_12"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ring_stress_day_ave_title"/>
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@android:color/white"
                android:id="@+id/tv_day_avg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_5"
                android:text="40"/>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="@android:color/white"
                android:id="@+id/tv_avg_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_5"
                android:text="@string/str_normal_press_range"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ring_stress_day_range_title"/>
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@android:color/white"
                android:id="@+id/tv_day_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_5"
                android:text="34-44"/>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="@android:color/white"
                android:id="@+id/tv_range_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_5"
                android:text="@string/str_normal_press_range"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
