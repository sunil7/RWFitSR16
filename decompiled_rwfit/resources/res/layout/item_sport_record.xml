<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_item_theme"
    android:padding="@dimen/qb_px_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:gravity="center"
        android:id="@+id/sport_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@mipmap/ic_sport_item_run"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_15"
        android:textStyle="bold"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/tv_sport_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跑步"
        android:layout_marginStart="@dimen/qb_px_10"
        app:layout_constraintLeft_toRightOf="@+id/sport_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_12"
        android:text="2022/05/25 10:22"
        android:layout_marginStart="@dimen/qb_px_10"
        app:layout_constraintLeft_toRightOf="@+id/sport_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_sport_type"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textStyle="bold"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/tv_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1.00"
        android:layout_marginStart="@dimen/qb_px_5"
        app:layout_constraintBottom_toBottomOf="@+id/tv_sport_type"
        app:layout_constraintLeft_toRightOf="@+id/tv_sport_type"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_15"
        android:textStyle="bold"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/tv_distance_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_km"
        app:layout_constraintBottom_toBottomOf="@+id/tv_sport_type"
        app:layout_constraintLeft_toRightOf="@+id/tv_distance"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        android:layout_marginStart="@dimen/qb_px_10"
        app:layout_constraintLeft_toRightOf="@+id/sport_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_date">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_cal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toRightOf="@+id/sport_icon"
            app:layout_constraintRight_toLeftOf="@+id/ll_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_date">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_cal"/>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="?attr/colorOnPrimary"
                android:layout_gravity="bottom"
                android:id="@+id/tv_calorie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100 KCAL"
                android:layout_marginStart="@dimen/qb_px_4"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_2"
            android:layout_marginStart="@dimen/qb_px_8"
            app:layout_constraintLeft_toRightOf="@+id/ll_cal"
            app:layout_constraintRight_toLeftOf="@+id/ll_pace"
            app:layout_constraintTop_toBottomOf="@+id/tv_date">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_time"/>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="?attr/colorOnPrimary"
                android:layout_gravity="bottom"
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:20"
                android:layout_marginStart="@dimen/qb_px_4"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_pace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_2"
            android:layout_marginStart="@dimen/qb_px_8"
            app:layout_constraintLeft_toRightOf="@+id/ll_time"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_date">
            <ImageView
                android:id="@+id/iv_item_pace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_pics"/>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="?attr/colorOnPrimary"
                android:layout_gravity="bottom"
                android:id="@+id/tv_pace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6&apos;30&apos;&apos;"
                android:layout_marginStart="@dimen/qb_px_4"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/sport_from_type"
        android:layout_width="11dp"
        android:layout_height="15dp"
        android:src="@mipmap/ic_sport_device"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_sport_type"/>
</androidx.constraintlayout.widget.ConstraintLayout>
