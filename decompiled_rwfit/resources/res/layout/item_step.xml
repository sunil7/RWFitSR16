<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/step_content"
    android:background="@drawable/bg_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.example.test.ui.view.CircleProgressView
        android:layout_gravity="center_horizontal"
        android:id="@+id/step_progress"
        android:layout_width="@dimen/qb_px_136"
        android:layout_height="@dimen/qb_px_136"
        android:layout_marginTop="@dimen/qb_px_12"
        android:layout_marginBottom="@dimen/qb_px_12"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qb_px_12">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_cal"/>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="@color/color_cccccc"
                android:id="@+id/tv_calorie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00KCAL"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_target"/>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="@color/color_cccccc"
                android:id="@+id/tv_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--步"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/qb_px_14"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_distance"/>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="@color/color_cccccc"
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00KM"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
