<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stress_content"
    android:background="@drawable/bg_item"
    android:padding="@dimen/qb_px_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/qb_px_24"
        android:layout_height="@dimen/qb_px_24"
        android:src="@mipmap/ic_stress"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_press_title"
        android:layout_alignTop="@+id/icon"
        android:layout_marginStart="@dimen/qb_px_8"
        android:layout_toEndOf="@+id/icon"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/qb_px_20"
        android:textStyle="bold"
        android:textColor="@color/color_45ffa5"
        android:id="@+id/tv_current_stress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_10"
        android:text="--"
        android:layout_below="@+id/icon"
        android:layout_marginStart="@dimen/qb_px_8"/>
    <TextView
        android:textSize="@dimen/qb_px_12"
        android:textColor="@color/color_cccccc"
        android:id="@+id/tv_stress_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qb_px_2"
        android:text="%"
        android:layout_alignBottom="@+id/tv_current_stress"
        android:layout_marginStart="@dimen/qb_px_2"
        android:layout_toEndOf="@+id/tv_current_stress"/>
    <com.example.test.ui.view.LineGradientChartView
        android:id="@+id/lineChart"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="@dimen/qb_px_18"
        android:layout_below="@+id/tv_current_stress"/>
</RelativeLayout>
