<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/family_friend_border"
    android:paddingTop="@dimen/qb_px_13"
    android:paddingBottom="@dimen/qb_px_13"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/qb_px_16"
    android:layout_marginEnd="@dimen/qb_px_16">
    <RelativeLayout
        android:id="@+id/rl_indoorrun"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_50">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/qb_px_30"
            android:layout_height="@dimen/qb_px_30"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="?attr/colorOnPrimary"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_52"/>
        <ImageView
            android:id="@+id/iv_more"
            android:layout_width="@dimen/qb_px_20"
            android:layout_height="@dimen/qb_px_20"
            android:src="@mipmap/ring_more_arrow"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/qb_px_20"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
