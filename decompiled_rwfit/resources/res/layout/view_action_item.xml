<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_item"
    android:paddingTop="@dimen/qb_px_15"
    android:paddingBottom="@dimen/qb_px_15"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/qb_px_10"
    android:paddingEnd="@dimen/qb_px_10">
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/qb_px_24"
        android:layout_height="@dimen/qb_px_24"
        android:src="@android:drawable/ic_dialog_email"/>
    <TextView
        android:textSize="@dimen/qb_px_16"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/itemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Item Name"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/qb_px_10"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/scBtn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:thumbTint="@color/ring_bottomtext_sel"
        app:trackTint="@drawable/ring_switch_track_color"/>
    <TextView
        android:textSize="@dimen/qb_px_14"
        android:textColor="@color/color_cccccc"
        android:id="@+id/tvTips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/qb_px_150"
        android:text="提示语"/>
    <com.example.test.ui.view.PointView
        android:id="@+id/pointView"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_10"
        android:layout_height="@dimen/qb_px_10"
        android:layout_marginStart="@dimen/qb_px_6"/>
    <ImageView
        android:id="@+id/ivNext"
        android:padding="@dimen/qb_px_4"
        android:layout_width="@dimen/qb_px_18"
        android:layout_height="@dimen/qb_px_24"
        android:layout_marginStart="@dimen/qb_px_8"
        app:srcCompat="@mipmap/ic_arrow_right"/>
</LinearLayout>
