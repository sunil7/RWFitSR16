<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:background="@drawable/bg_item"
    android:paddingLeft="@dimen/qb_px_18"
    android:paddingTop="@dimen/qb_px_30"
    android:paddingRight="@dimen/qb_px_16"
    android:paddingBottom="@dimen/qb_px_30"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/deviceIcon"
            android:layout_width="@dimen/qb_px_62"
            android:layout_height="@dimen/qb_px_100"
            android:src="@mipmap/ic_normal_dial"/>
        <Button
            android:textSize="@dimen/qb_px_13"
            android:textColor="@android:color/white"
            android:id="@+id/btnBind"
            android:background="@drawable/bg_btn"
            android:visibility="gone"
            android:layout_width="@dimen/qb_px_136"
            android:layout_height="@dimen/qb_px_44"
            android:layout_marginTop="@dimen/qb_px_20"
            android:text="@string/str_bind"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llBind"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/qb_px_16">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/qb_px_16"
            android:paddingBottom="@dimen/qb_px_10"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2">
            <TextView
                android:textSize="@dimen/qb_px_17"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DW01"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10">
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@android:color/white"
                    android:id="@+id/firmwareVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="版本号: v1.0.0"/>
                <com.example.test.ui.view.PointView
                    android:id="@+id/point"
                    android:visibility="gone"
                    android:layout_width="@dimen/qb_px_6"
                    android:layout_height="@dimen/qb_px_6"
                    android:layout_marginStart="@dimen/qb_px_4"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="@android:color/white"
                android:id="@+id/mac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_10"
                android:text="MAC: 0A:0C:BF:AA:0B:CF"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.example.test.ui.view.PowerView
                    android:id="@+id/powerView"
                    android:layout_width="@dimen/qb_px_28"
                    android:layout_height="@dimen/qb_px_13"/>
                <TextView
                    android:textSize="@dimen/qb_px_12"
                    android:textColor="@android:color/white"
                    android:id="@+id/powerTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="78%"
                    android:layout_marginStart="@dimen/qb_px_4"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/qb_px_12"
                android:textColor="@android:color/white"
                android:id="@+id/tv_ota"
                android:background="@drawable/bg_btn_blue"
                android:paddingLeft="@dimen/qb_px_8"
                android:paddingTop="@dimen/qb_px_6"
                android:paddingRight="@dimen/qb_px_8"
                android:paddingBottom="@dimen/qb_px_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_ota"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
