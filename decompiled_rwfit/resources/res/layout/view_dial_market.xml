<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_item"
    android:padding="@dimen/qb_px_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/dialMarketTitle"
        android:paddingBottom="@dimen/qb_px_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/qb_px_16"
            android:textColor="@android:color/white"
            android:id="@+id/dialMarketTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_dial_market"/>
        <TextView
            android:textSize="@dimen/qb_px_14"
            android:textColor="@color/color_cccccc"
            android:gravity="end"
            android:id="@+id/moreTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/str_more"
            android:layout_weight="1"/>
        <ImageView
            android:textColor="@android:color/white"
            android:layout_width="@dimen/qb_px_10"
            android:layout_height="@dimen/qb_px_16"
            android:src="@mipmap/ic_arrow_right"
            android:layout_marginStart="@dimen/qb_px_6"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/qb_px_1"
            android:layout_weight="0.5"/>
        <com.example.test.ui.view.DialItemView
            android:id="@+id/dialFirst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/qb_px_1"
            android:layout_weight="1"/>
        <com.example.test.ui.view.DialItemView
            android:id="@+id/dialSec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/qb_px_1"
            android:layout_weight="1"/>
        <com.example.test.ui.view.DialItemView
            android:id="@+id/dialTh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/qb_px_1"
            android:layout_weight="0.5"/>
    </LinearLayout>
</LinearLayout>
