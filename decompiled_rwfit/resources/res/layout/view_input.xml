<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/border_select"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_56"
    android:paddingStart="@dimen/qb_px_8"
    android:paddingEnd="@dimen/qb_px_8">
    <ImageView
        android:id="@+id/itemIcon"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_24"
        android:layout_height="@dimen/qb_px_24"
        android:layout_marginEnd="@dimen/qb_px_8"/>
    <EditText
        android:textSize="@dimen/qb_px_14"
        android:textColor="?attr/colorOnPrimary"
        android:textColorHint="@color/color_cccccc"
        android:ellipsize="end"
        android:id="@+id/etInput"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/qb_px_20"/>
    <ImageView
        android:id="@+id/itemImgAction"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_24"
        android:layout_height="@dimen/qb_px_24"
        android:layout_marginEnd="@dimen/qb_px_8"/>
    <TextView
        android:textSize="@dimen/qb_px_10"
        android:textColor="?attr/colorOnPrimary"
        android:gravity="center"
        android:id="@+id/itemTxtAction"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/str_rev_code"/>
</LinearLayout>
