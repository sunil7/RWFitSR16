<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:background="?attr/colorPrimary"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_140">
    <ImageView
        android:id="@+id/iv_userheader"
        android:layout_width="@dimen/qb_px_50"
        android:layout_height="@dimen/qb_px_50"
        android:src="@mipmap/ic_header_default"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/qb_px_4"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/tv_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qb_px_26"
        android:text="Visitor"
        android:maxLines="2"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/qb_px_20"
        android:layout_toEndOf="@+id/iv_userheader"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/tv_user_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qb_px_3"
        android:text="ID:"
        android:maxLines="2"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/qb_px_20"
        android:layout_toEndOf="@+id/iv_userheader"/>
</RelativeLayout>
