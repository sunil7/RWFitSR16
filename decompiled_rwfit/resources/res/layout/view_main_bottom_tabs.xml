<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/tabParent"
    android:background="@color/ring_bottommenu_bg"
    android:paddingTop="@dimen/qb_px_6"
    android:paddingBottom="@dimen/qb_px_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.example.test.ui.view.TabView
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.example.test.ui.view.TabView
        android:id="@+id/tabSport"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.example.test.ui.view.TabView
        android:id="@+id/tabDevice"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.example.test.ui.view.TabView
        android:id="@+id/tabMine"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
</LinearLayout>
