<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/barStatusIv"
        android:layout_width="@dimen/qb_px_22"
        android:layout_height="@dimen/qb_px_22"
        android:src="@mipmap/ic_tb_menu"
        android:layout_marginStart="@dimen/qb_px_10"/>
    <ImageView
        android:id="@+id/empty"
        android:layout_width="@dimen/qb_px_22"
        android:layout_height="@dimen/qb_px_22"
        android:layout_marginStart="@dimen/qb_px_10"/>
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/barTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/str_connected"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/qb_px_10"/>
    <ImageView
        android:id="@+id/option1"
        android:padding="@dimen/qb_px_10"
        android:visibility="invisible"
        android:layout_width="@dimen/qb_px_42"
        android:layout_height="@dimen/qb_px_42"
        android:src="@mipmap/ic_tb_refresh"
        android:layout_marginStart="@dimen/qb_px_10"/>
    <ImageView
        android:id="@+id/option2"
        android:padding="@dimen/qb_px_10"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_42"
        android:layout_height="@dimen/qb_px_42"
        android:src="@mipmap/ic_tb_share"/>
</LinearLayout>
