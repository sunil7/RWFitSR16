<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_sport_card"
    android:paddingBottom="@dimen/qb_px_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/qb_px_32"
        android:textStyle="bold"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/distanceTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_24"
        android:text="0.00"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/qb_px_24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/qb_px_18"
        android:textColor="?attr/colorOnPrimary"
        android:id="@+id/distanceUnitTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qb_px_4"
        android:text="公里"
        android:layout_marginStart="@dimen/qb_px_8"
        app:layout_constraintBottom_toBottomOf="@+id/distanceTv"
        app:layout_constraintLeft_toRightOf="@+id/distanceTv"/>
    <com.example.test.ui.view.GpsView
        android:id="@+id/gpsSingleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:src="@mipmap/ic_gps"
        android:layout_marginEnd="@dimen/qb_px_18"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/distanceTv"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_kcal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_25"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/ll_time"
        app:layout_constraintTop_toBottomOf="@+id/distanceTv">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_cal"/>
        <TextView
            android:textSize="@dimen/qb_px_24"
            android:textColor="?attr/colorOnPrimary"
            android:id="@+id/caloriesTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_6"
            android:text="0.00"/>
        <TextView
            android:textSize="@dimen/qb_px_16"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_6"
            android:text="@string/str_Kcal"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_25"
        app:layout_constraintLeft_toRightOf="@+id/ll_kcal"
        app:layout_constraintRight_toLeftOf="@+id/ll_pics"
        app:layout_constraintTop_toBottomOf="@+id/distanceTv">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_time"/>
        <TextView
            android:textSize="@dimen/qb_px_24"
            android:textColor="?attr/colorOnPrimary"
            android:id="@+id/totalTimeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_6"
            android:text="00:00:00"/>
        <TextView
            android:textSize="@dimen/qb_px_16"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_6"
            android:text="@string/str_time"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_pics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_25"
        app:layout_constraintLeft_toRightOf="@+id/ll_time"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/distanceTv">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_hr_check"/>
        <TextView
            android:textSize="@dimen/qb_px_24"
            android:textColor="?attr/colorOnPrimary"
            android:id="@+id/currentPaceTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_6"
            android:text="--"/>
        <TextView
            android:textSize="@dimen/qb_px_16"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_6"
            android:text="@string/str_hr_title"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
